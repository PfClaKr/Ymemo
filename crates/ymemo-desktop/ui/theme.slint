import { LineEdit } from "std-widgets.slint";
import { Strings } from "@i18n";
// Pieces shared by several windows: the sticky palette and the tab button.
// Palette keys ("yellow"/"pink"/"green"/"blue"/"purple") become real colors only here; the
// core stores and syncs the key string alone.
// Room a ScrollView's own scrollbar takes along the right edge.
//
// `visible-width` does not leave it: content given that width runs *under* the bar and is
// clipped by the window edge instead — measured on the settings window, where every hint lost
// its last word and "check now" lost its right half. Anything bound to `visible-width` takes
// this off it.
export global Scroll {
    out property <length> gutter: 14px;
}

export global Palette {
    // The paper a note is written on: a near-white tint of its colour, barely translucent
    // so it still reads as a desktop widget. Pale on purpose — the writing has to stay
    // legible at the small default size, and the colour is carried by the title bar and
    // the border, where it is seen even while the note is folded.
    pure public function bg(key: string) -> color {
        return key == "pink" ? #fff2f7f7
             : key == "green" ? #f2fceff7
             : key == "blue" ? #eff7fff7
             : key == "purple" ? #f8f2fdf7
             : #fffce3f7; // yellow (default)
    }
    // The line around the note, a shade past the title bar so the paper has a real edge
    // against whatever is behind it.
    pure public function edge(key: string) -> color {
        return key == "pink" ? #ef94b6
             : key == "green" ? #83c96f
             : key == "blue" ? #71ade4
             : key == "purple" ? #ab83d8
             : #e2c74e; // yellow
    }
    // Title bar: opaque and darker than the body.
    pure public function bar(key: string) -> color {
        return key == "pink" ? #f7b8ce
             : key == "green" ? #b6e0a8
             : key == "blue" ? #b0d4f2
             : key == "purple" ? #d0b8ec
             : #f4e98c; // yellow
    }
    // Title bar text, keeping contrast per color.
    pure public function ink(key: string) -> color {
        return key == "pink" ? #7a3350
             : key == "green" ? #35662f
             : key == "blue" ? #2a5578
             : key == "purple" ? #573377
             : #5c5c25; // yellow
    }
    // Saturated accent for palette chips and list rows.
    pure public function swatch(key: string) -> color {
        return key == "pink" ? #ff9fc0
             : key == "green" ? #8fd678
             : key == "blue" ? #7db8ec
             : key == "purple" ? #b98fe0
             : #ffe15c; // yellow
    }
}


// Device pairing panel.

// One tab at the top of the pairing panel. Showing a single method at a time is what keeps
// each view inside the window without scrolling.
export component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> ink;
    callback clicked();

    height: 26px;
    // Rounded like every other control in these windows; the square segments were the one
    // hard corner among the cards, switches and buttons around them.
    border-radius: 5px;
    background: root.active ? #ffffff26 : ta.has-hover ? #ffffff14 : #ffffff08;
    border-width: 1px;
    border-color: root.active ? #ffffff59 : #ffffff1f;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    // The label in a layout rather than filling the box, so the button has a width of its
    // own. It had none: in a row that ends in a stretchy spacer the two update toggles
    // collapsed onto their own letters, 켜기/끄기 pressed against the border.
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 700 : 400;
            color: root.ink;
            opacity: root.active ? 1.0 : 0.7;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Window furniture drawn as paths rather than typed as emoji.
//
// Every pictograph the UI draws comes from here, and none of them from a font. Emoji need an
// emoji font, and a Linux install without one — the common case, since `fonts-noto-cjk` covers
// Korean but not emoji — draws them as an empty box; the arrows and dingbats are no safer, as
// `⟲` and `✕` are in no Windows UI font and left the history button blank and the close button
// a featureless dot there. A path is the same on every machine, scales with the display
// instead of blurring the way a bitmap at 150% would, takes the surrounding ink for free, and
// stays sharp under the software renderer.
//
// Anything new that would have been an emoji belongs in `commands` below, not in a string —
// least of all a translated one, which would make every translator carry the glyph too.
// ---------------------------------------------------------------------------
export component Glyph inherits Path {
    in property <string> name;

    viewbox-width: 16;
    viewbox-height: 16;
    stroke-width: 1.4px;
    // Outlines only: a filled shape at 16px turns into a blob, and the stroke picks up the
    // button's ink for free.
    commands: root.name == "lock"
            ? "M 4.5 7.5 L 11.5 7.5 L 11.5 13.5 L 4.5 13.5 Z M 6 7.5 L 6 5.2 C 6 2.9 10 2.9 10 5.2 L 10 7.5"
        : root.name == "link"
            ? "M 7 5.5 L 5.5 5.5 C 3.4 5.5 3.4 10.5 5.5 10.5 L 7 10.5 M 9 5.5 L 10.5 5.5 C 12.6 5.5 12.6 10.5 10.5 10.5 L 9 10.5 M 5.8 8 L 10.2 8"
        : root.name == "folder"
            ? "M 2.5 12.8 L 2.5 4.2 L 6.4 4.2 L 7.9 6 L 13.5 6 L 13.5 12.8 Z"
        : root.name == "gear"
            ? "M 8 2.6 L 8 4.4 M 8 11.6 L 8 13.4 M 2.6 8 L 4.4 8 M 11.6 8 L 13.4 8 M 4.2 4.2 L 5.5 5.5 M 10.5 10.5 L 11.8 11.8 M 11.8 4.2 L 10.5 5.5 M 5.5 10.5 L 4.2 11.8 M 8 5.3 C 9.5 5.3 10.7 6.5 10.7 8 C 10.7 9.5 9.5 10.7 8 10.7 C 6.5 10.7 5.3 9.5 5.3 8 C 5.3 6.5 6.5 5.3 8 5.3 Z"
        : root.name == "plus"
            ? "M 8 3.4 L 8 12.6 M 3.4 8 L 12.6 8"
        : root.name == "trash"
            ? "M 3.4 4.8 L 12.6 4.8 M 6.2 4.8 L 6.2 3.2 L 9.8 3.2 L 9.8 4.8 M 4.7 4.8 L 5.4 13.2 L 10.6 13.2 L 11.3 4.8 M 7 7 L 7.3 11 M 9 7 L 8.7 11"
        : root.name == "pin"
            ? "M 5.6 2.8 L 10.4 2.8 M 6.4 2.8 L 6.0 7.2 C 4.9 7.9 4.3 8.9 4.3 9.6 L 11.7 9.6 C 11.7 8.9 11.1 7.9 10.0 7.2 L 9.6 2.8 M 8 9.6 L 8 13.4"
        : root.name == "pin-off"
            ? "M 5.6 2.8 L 10.4 2.8 M 6.4 2.8 L 6.0 7.2 C 4.9 7.9 4.3 8.9 4.3 9.6 L 11.7 9.6 C 11.7 8.9 11.1 7.9 10.0 7.2 L 9.6 2.8 M 8 9.6 L 8 13.4 M 3.0 13.0 L 13.0 3.0"
        : root.name == "close"
            ? "M 4.6 4.6 L 11.4 11.4 M 11.4 4.6 L 4.6 11.4"
        : root.name == "history"
            ? "M 3.4 6.4 L 3.4 3.2 M 3.4 6.4 L 6.6 6.4 M 3.7 6.6 C 5.0 4.4 7.6 3.3 10.0 4.1 C 12.5 4.9 13.9 7.6 13.1 10.1 C 12.3 12.6 9.6 13.9 7.2 13.1 C 5.8 12.7 4.7 11.6 4.2 10.3"
        : root.name == "resize"
            ? "M 12.6 6.4 L 12.6 12.6 L 6.4 12.6 M 12.6 9.6 L 9.6 12.6"
        : root.name == "chevron-down"
            ? "M 4.4 6.4 L 8 10 L 11.6 6.4"
        : root.name == "chevron-right"
            ? "M 6.4 4.4 L 10 8 L 6.4 11.6"
        // Filled, and drawn as one closed shape: this is the mark that says "folder" in a
        // 34px row, and the outline version's tab was a pixel and a half wide there — it
        // read as a plain rectangle. Set `fill` rather than `stroke` on this one.
        : root.name == "folder-solid"
            ? "M 3.6 3.4 L 6.4 3.4 C 6.75 3.4 7.05 3.55 7.25 3.8 L 8.3 5.1 L 12.4 5.1 C 13.1 5.1 13.6 5.6 13.6 6.3 L 13.6 12.3 C 13.6 13.0 13.1 13.5 12.4 13.5 L 3.6 13.5 C 2.9 13.5 2.4 13.0 2.4 12.3 L 2.4 4.6 C 2.4 3.9 2.9 3.4 3.6 3.4 Z"
        : root.name == "search"
            ? "M 7.1 3.2 C 9.3 3.2 11 4.9 11 7.1 C 11 9.3 9.3 11 7.1 11 C 4.9 11 3.2 9.3 3.2 7.1 C 3.2 4.9 4.9 3.2 7.1 3.2 Z M 9.9 9.9 L 13 13"
        : root.name == "undo"
            ? "M 6.6 4.2 L 3.4 7.4 L 6.6 10.6 M 3.4 7.4 L 9.8 7.4 C 12.0 7.4 13.0 8.7 13.0 10.2 C 13.0 11.7 12.0 13.0 9.8 13.0"
        // "Add a picture", on a note's bar: a frame, a hill and a small sun, all outlines. At
        // 14px on the bar there is room for the sun that the list-size `photo` below leaves out.
        : root.name == "image"
            ? "M 2.6 3.4 L 13.4 3.4 L 13.4 12.6 L 2.6 12.6 Z M 2.6 11 L 6.2 7.4 L 9.2 10.4 M 8.2 9.4 L 10.4 7.4 L 13.4 10.2 M 10.2 4.9 C 10.8 4.9 11.3 5.4 11.3 6 C 11.3 6.6 10.8 7.1 10.2 7.1 C 9.6 7.1 9.1 6.6 9.1 6 C 9.1 5.4 9.6 4.9 10.2 4.9 Z"
        // A picture: a frame with a hill and a sun in it. The same silhouette as the sticky's
        // own attach button, at list size.
        // A frame with one hill in it, and nothing else. This is drawn at 13px in a list row,
        // where a sun and a second slope filled the frame in and came out as a smudge.
        : root.name == "photo"
            ? "M 2.6 4.4 L 13.4 4.4 L 13.4 11.6 L 2.6 11.6 Z M 3.6 10.6 L 7 7.2 L 10.4 10.6"
        // The two ways a photo can sit on a note, drawn as what they do rather than named:
        // "float" is a picture lying across the lines of writing, "flow" is one sitting under
        // them with the lines stopping above it. Each button shows the state it switches to.
        : root.name == "photo-float"
            ? "M 2.4 4.2 L 13.6 4.2 M 2.4 11.8 L 13.6 11.8 M 5.0 6.0 L 11.0 6.0 L 11.0 10.0 L 5.0 10.0 Z"
        // A page going into a tray: "keep a copy of this outside the app".
        : root.name == "save"
            ? "M 8 3.2 L 8 9.6 M 5.2 7.2 L 8 10 L 10.8 7.2 M 3.2 11.2 L 3.2 12.4 C 3.2 12.9 3.6 13.2 4 13.2 L 12 13.2 C 12.4 13.2 12.8 12.9 12.8 12.4 L 12.8 11.2"
        : root.name == "photo-flow"
            ? "M 2.4 3.6 L 13.6 3.6 M 2.4 6.0 L 10.0 6.0 M 4.0 8.4 L 12.0 8.4 L 12.0 13.0 L 4.0 13.0 Z"
        // The settings' side menu. A note is the app's own silhouette: a sheet peeled at the
        // bottom right with two lines on it.
        : root.name == "note"
            ? "M 3.4 2.8 L 12.6 2.8 L 12.6 9.6 L 9.2 13.2 L 3.4 13.2 Z M 12.6 9.6 L 9.2 9.6 L 9.2 13.2 M 5.6 6 L 10.4 6 M 5.6 8.2 L 8.4 8.2"
        : root.name == "keyboard"
            ? "M 2 4.4 L 14 4.4 L 14 11.6 L 2 11.6 Z M 4.4 6.9 L 4.8 6.9 M 7 6.9 L 7.4 6.9 M 9.6 6.9 L 10 6.9 M 11.6 6.9 L 12 6.9 M 5.4 9.2 L 10.6 9.2"
        : root.name == "info"
            ? "M 8 2.6 C 11 2.6 13.4 5 13.4 8 C 13.4 11 11 13.4 8 13.4 C 5 13.4 2.6 11 2.6 8 C 2.6 5 5 2.6 8 2.6 Z M 8 7.4 L 8 11 M 8 5 L 8 5.5"
        // Arrow keys, in the settings' list of shortcuts: typed as ↑ ↓ they depend on a font.
        : root.name == "arrow-up"
            ? "M 8 12.6 L 8 3.6 M 4.6 7 L 8 3.6 L 11.4 7"
        : root.name == "arrow-down"
            ? "M 8 3.4 L 8 12.4 M 4.6 9 L 8 12.4 L 11.4 9"
        : root.name == "data"
            ? "M 3.4 4.2 C 3.4 2.6 12.6 2.6 12.6 4.2 C 12.6 5.8 3.4 5.8 3.4 4.2 Z M 3.4 4.2 L 3.4 11.8 C 3.4 13.4 12.6 13.4 12.6 11.8 L 12.6 4.2 M 3.4 8 C 3.4 9.6 12.6 9.6 12.6 8"
            : "";
}

// A header button: the glyph above on a chip that lights up under the pointer.
//
// `hovering` is how the window puts the name of what it does on screen — these icons replaced
// emoji, and a row of five silent pictograms is worse than the boxes it replaced. There is no
// tooltip of its own here on purpose: it would be drawn inside the header row and every later
// sibling in the window's layout paints over it.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink: #e8e2d2;
    in property <bool> enabled: true;
    // A status dot in the corner: 0 none, 1 good (filled green), 2 waiting (hollow grey),
    // 3 off (filled muted red).
    in property <int> badge: 0;
    // The window's main action: filled with the app's gold, the glyph dark on it, so the one
    // button that makes something new stands out from the row of settings-like ones.
    in property <bool> primary: false;
    // Pressed in: the panel this button opens is the one on screen. The pairing panel takes
    // the window's whole body, and nothing else said that pressing the same button again is
    // the way back to the memos.
    in property <bool> active: false;
    out property <bool> hovering: ta.has-hover;
    callback clicked();

    width: 30px;
    height: 26px;
    border-radius: 5px;
    background: !root.enabled ? #ffffff08
        : root.primary ? (ta.has-hover ? #f5d24a : #e2c22a)
        : root.active ? (ta.has-hover ? #e2c22a59 : #e2c22a40)
        : ta.has-hover ? #ffffff33
        : #ffffff14;
    border-width: root.active ? 1px : 0px;
    border-color: #e2c22a99;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: root.icon;
        stroke: root.primary ? #3a3208 : root.active ? #f0dc80 : root.ink;
    }

    if root.badge != 0: Rectangle {
        x: parent.width - 9px;
        y: 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.badge == 1 ? #6fae6f : root.badge == 3 ? #c97a6e : transparent;
        border-width: root.badge == 2 ? 1.5px : 0px;
        border-color: #a8a294;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// A text field: std `LineEdit` with the app's gold for its focus line.
//
// The std line is the OS accent (blue on Windows), read-only in the style's palette, and it
// was the last blue thing on a gold screen — under the password on the lock window above all.
// So the same field, with a gold line of the same size drawn over the blue one. Everything a
// caller used on a `LineEdit` is passed through.
// ---------------------------------------------------------------------------
export component Field inherits Rectangle {
    in-out property <string> text <=> le.text;
    in property <string> placeholder-text <=> le.placeholder-text;
    in property <InputType> input-type <=> le.input-type;
    in property <bool> enabled <=> le.enabled;
    in property <bool> read-only <=> le.read-only;
    in property <length> font-size <=> le.font-size;
    out property <bool> has-focus: le.has-focus;
    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    public function select-all() { le.select-all(); }

    forward-focus: le;
    min-width: le.min-width;
    min-height: le.min-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    le := LineEdit {
        width: 100%;
        height: 100%;
        accepted(t) => { root.accepted(t); }
        edited(t) => { root.edited(t); }
        key-pressed(ev) => { return root.key-pressed(ev); }
    }
    // Where the std field draws its focus line: inset by its corner radius, 2px, at the foot.
    if le.has-focus && le.enabled: Rectangle {
        x: 4px;
        y: parent.height - 2px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: #e2c22a;
    }
}

// ---------------------------------------------------------------------------
// A window's main action, in the app's gold — the `+` in the list is the same colour.
//
// Not std `Button { primary: true }`: that fills with the style's accent, which is the
// operating system's accent colour (Windows' blue unless the user chose another), and the
// palette that holds it is read-only. So "Save" and "Restore" were a light blue nobody had
// picked, next to a gold `+`. Same metrics as the std button (32px, 12px sides, 4px corners)
// so the two sit in one row. `danger` is for the confirming half of something that cannot be
// undone, which should not look like the inviting choice.
// ---------------------------------------------------------------------------
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    min-width: max(64px, label.preferred-width + 24px);
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    forward-focus: fs;
    background: !root.enabled ? #ffffff1f
        : root.danger ? (ta.pressed ? #a4574b : ta.has-hover ? #c9705f : #b9624f)
        : (ta.pressed ? #cfae1c : ta.has-hover ? #f0cf45 : #e2c22a);
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    label := Text {
        text: root.text;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? #ffffff66 : root.danger ? #ffffff : #3a3208;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Space and Return press it once it has the focus, like the std buttons beside it.
    fs := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if fs.has-focus && root.enabled: Rectangle {
        border-radius: root.border-radius + 2px;
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-width: 2px;
        border-color: #f0ead6;
    }
}

// ---------------------------------------------------------------------------
// An on/off switch. The settings used to offer a pair of "On" / "Off" tab buttons for each
// yes-or-no setting, which asked a question with two answers where one control says it.
// ---------------------------------------------------------------------------
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? (ta.has-hover ? #f0cf45 : #e2c22a) : (ta.has-hover ? #ffffff38 : #ffffff24);
    animate background { duration: 150ms; }
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.label;
    accessible-action-default => { root.flip(); }
    forward-focus: fs;

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        animate x { duration: 150ms; easing: ease-out; }
        background: root.checked ? #3a3208 : #d8d2c2;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }

    fs := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    // Where Tab has landed, as on `PrimaryButton`: without it a keyboard user flipped
    // switches they could not see were the ones being pointed at.
    if fs.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: root.border-radius + 2px;
        border-width: 2px;
        border-color: #f0ead6;
    }
}

// ---------------------------------------------------------------------------
// One of the two ways to start, on the first run: a heading and the sentence that says what
// pressing it will actually do.
//
// A card rather than a button, because the choice is not reversible in the way a button
// implies — creating a vault on a device that should have been paired gives it a key of its
// own, and the two never merge. The explanation has to be *on* the choice, not in a footnote
// under both of them.
// ---------------------------------------------------------------------------
export component SetupChoice inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled ? #ffffff14
        : ta.has-hover ? #e8d98a
        : #ffffff2b;
    background: !root.enabled ? #ffffff08
        : ta.has-hover ? #ffffff1a
        : #ffffff0f;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.detail;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: #f0ead6;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            font-size: 11px;
            color: #b8b2a2;
            wrap: word-wrap;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// One colour to pick, as a round chip: the note's own colour panel, the list's inline palette
// and the settings' default colour all choose from these five, and all three drew the chip by
// hand — with no pointer cursor on two of them, nothing under the pointer on any, and nothing
// a screen reader could say about which colour it was.
// ---------------------------------------------------------------------------
export component ColorChip inherits Rectangle {
    in property <string> key;
    in property <bool> selected;
    in property <length> size: 19px;
    callback picked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Palette.swatch(root.key);
    border-width: root.selected ? 3px : ta.has-hover ? 2px : 1px;
    border-color: root.selected ? #ffffff : ta.has-hover ? #ffffffb3 : #00000040;
    accessible-role: button;
    accessible-label: root.key == "pink" ? Strings.ui_color_pink
        : root.key == "green" ? Strings.ui_color_green
        : root.key == "blue" ? Strings.ui_color_blue
        : root.key == "purple" ? Strings.ui_color_purple
        : Strings.ui_color_yellow;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.picked(); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// ---------------------------------------------------------------------------
// A slider in the app's own ink. The standard one is the platform's accent — Windows' blue —
// which was the loudest thing on a scrap of yellow paper and the one blue control left in the
// gold settings window. The note's colour panel passes the note's ink; the dark windows keep
// the gold default.
// ---------------------------------------------------------------------------
export component InkSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // Snaps to multiples of this when above zero.
    in property <float> step: 0;
    in property <float> value;
    in property <color> ink: #e2c22a;
    in property <color> track: root.ink.with-alpha(0.22);
    in property <string> label;
    callback changed(float);
    callback released(float);
    min-height: 18px;
    horizontal-stretch: 1;
    private property <float> fraction: (root.value - root.minimum) / (root.maximum - root.minimum);
    private property <length> knob: 12px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step > 0 ? root.step : 1;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }
    forward-focus: fs;

    function snap(v: float) -> float {
        root.step > 0 ? Math.round(v / root.step) * root.step : v
    }
    // Arrow keys move it one step (or a twentieth of the range), and land at once, the way
    // a release of the pointer does.
    function nudge(dir: int) {
        let by = root.step > 0 ? root.step : (root.maximum - root.minimum) / 20;
        let v = Math.clamp(root.snap(root.value + dir * by), root.minimum, root.maximum);
        root.changed(v);
        root.released(v);
    }

    // The track, and the part of it to the left of the knob. Both pinned to the left edge:
    // a child with no `x` is centred, and the filled part used to grow out from the middle.
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: 3px;
        border-radius: 1.5px;
        background: root.track;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.fraction * (parent.width - root.knob) + root.knob / 2;
        height: 3px;
        border-radius: 1.5px;
        background: root.ink.with-alpha(0.7);
    }
    Rectangle {
        x: root.fraction * (parent.width - root.knob);
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.ink;
        border-width: 2px;
        border-color: fs.has-focus ? #ffffff : #ffffffcc;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        function at(x: length) -> float {
            root.snap(root.minimum + Math.clamp((x - root.knob / 2) / (root.width - root.knob), 0, 1)
                * (root.maximum - root.minimum))
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                fs.focus();
                root.changed(self.at(self.mouse-x));
            }
            if (ev.kind == PointerEventKind.up) { root.released(self.at(self.mouse-x)); }
        }
        moved => { if (self.pressed) { root.changed(self.at(self.mouse-x)); } }
    }
    fs := FocusScope {
        width: 0px;
        key-pressed(ev) => {
            if (ev.text == Key.RightArrow || ev.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            if (ev.text == Key.LeftArrow || ev.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            return reject;
        }
    }
}
