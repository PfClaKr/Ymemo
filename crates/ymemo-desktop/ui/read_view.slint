import { Palette } from "theme.slint";

// ---------------------------------------------------------------------------
// A memo as it reads: the markdown regions drawn as markdown and the code blocks coloured,
// one `ReadBlock` per piece `markdown.rs` cut it into. Shared by the sticky's read view and
// the history window's preview, so an old version looks like the note it was.
// ---------------------------------------------------------------------------

// One piece of a memo as the read view draws it: either markdown for Slint's own styled text,
// or the inside of a fenced code block. See `markdown.rs`.
// A fenced code block, coloured. One line of it, and one run of one line — see
// `highlight.rs`. Empty `lines` means the fence named no language this build knows, and the
// block is drawn from `NoteBlock.text` exactly as it was typed.
export struct CodeToken {
    text: string,
    color: color,
}
export struct CodeLine {
    tokens: [CodeToken],
}

export struct NoteBlock {
    // The prose, already parsed: `@markdown()` reads its *literal* at compile time, so text
    // that only exists at runtime has to arrive styled. `markdown.rs` does the parsing.
    styled: styled-text,
    // The inside of a fenced code block, drawn as it was typed.
    text: string,
    code: bool,
    lines: [CodeLine],
    font-size: length,
}

export component ReadBlock inherits VerticalLayout {
    in property <NoteBlock> block;
    // The note's palette key: the code block's wash and the links are in its ink.
    in property <string> color-key;
    in property <float> text-scale: 1.0;

    if root.block.code: Rectangle {
        background: Palette.ink(root.color-key).with-alpha(0.07);
        border-radius: 4px;
        VerticalLayout {
            padding: 5px;
            // Coloured when the fence named a language, and one plain block when it did not.
            // Code is not wrapped either way: a line broken in the middle is harder to read
            // than one that runs off.
            if root.block.lines.length > 0: VerticalLayout {
                for codeline in root.block.lines: HorizontalLayout {
                    alignment: start;
                    for run in codeline.tokens: Text {
                        text: run.text;
                        font-family: "monospace";
                        font-size: root.block.font-size * root.text-scale;
                        color: run.color;
                    }
                }
            }
            if root.block.lines.length == 0: Text {
                text: root.block.text;
                font-family: "monospace";
                font-size: root.block.font-size * root.text-scale;
                color: #2b2b22;
                wrap: word-wrap;
            }
        }
    }
    if !root.block.code: StyledText {
        text: root.block.styled;
        default-font-size: root.block.font-size * root.text-scale;
        default-color: #2b2b22;
        // In the note's ink, not Slint's default pure blue: nothing here can be clicked (the
        // field is on top, see `StickyWindow`), and #00f on paper both promised a link that
        // does nothing and was the one OS blue left on a note.
        link-color: Palette.ink(root.color-key);
    }
}
