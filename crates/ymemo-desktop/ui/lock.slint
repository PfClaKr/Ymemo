import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { PairingPanel, SharedDeviceRow } from "pairing.slint";

// ---------------------------------------------------------------------------
// Lock window: the master password prompt, hidden once unlocked.
// ---------------------------------------------------------------------------
export component LockWindow inherits Window {
    title: Strings.ui_lock_title;
    preferred-width: 320px;
    preferred-height: 300px;
    min-height: 200px;
    background: #2e2b27;

    in property <string> lock-message;
    in property <bool> sync-available: false;
    in property <string> my-pairing-code;
    in property <image> qr-image;
    in property <string> peer-message;
    in property <string> lan-pair-code;
    in property <string> lan-message;
    // Whether vault.json exists: true is an existing vault (unlock), false a new device
    // (choice screen). Rust flips it once pairing delivers vault.json.
    in property <bool> vault-exists: false;
    in property <[SharedDeviceRow]> shared-devices;
    callback unlock(string);
    callback create-vault(string);
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);
    // Fires as the pairing panel opens and closes; Rust grows the window to fit it and
    // shrinks it back.
    callback sync-toggled(bool);

    // in-out so Rust can close it when the vault arrives.
    in-out property <bool> show-sync: false;
    changed show-sync => { root.sync-toggled(self.show-sync); }
    // Whether a new device chose "create" and moved on to setting a password.
    private property <bool> creating: false;
    // Contents of the password field. The LineEdit sits inside a conditional block and
    // cannot be reached by id, so it is two-way bound here and cleared by Rust on lock.
    private property <string> password-text;
    public function clear-password() { root.password-text = ""; }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Ymemo 🔒";
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "🔗";
                clicked => { root.show-sync = !root.show-sync; }
            }
        }

        if root.show-sync: VerticalLayout {
            vertical-stretch: 1;
            PairingPanel {
                available: root.sync-available;
                my-code: root.my-pairing-code;
                qr: root.qr-image;
                message: root.peer-message;
                lan-code: root.lan-pair-code;
                lan-message: root.lan-message;
                devices: root.shared-devices;
                ink: #d8d2c2;
                add-peer(code) => { root.add-peer(code); }
                lan-join(code) => { root.lan-join(code); }
                unshare(id) => { root.unshare(id); }
            }
            // Push the slack downwards so the panel stays at the top.
            Rectangle { vertical-stretch: 1; }
        }

        if !root.show-sync: VerticalLayout {
            spacing: 8px;
            Text {
                text: root.lock-message;
                font-size: 12px;
                color: #e79a9a;
                wrap: word-wrap;
            }

            // Existing vault: unlock with the master password.
            if root.vault-exists: HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: Strings.ui_lock_password_placeholder;
                    input-type: InputType.password;
                    text <=> root.password-text;
                    accepted => { root.unlock(self.text); }
                }
                Button {
                    text: Strings.ui_lock_open;
                    clicked => { root.unlock(root.password-text); }
                }
            }

            // First run on a new device: pick how to start.
            if !root.vault-exists && !root.creating: VerticalLayout {
                spacing: 8px;
                Text {
                    text: Strings.ui_lock_start_question;
                    font-size: 13px;
                    color: #f0ead6;
                    wrap: word-wrap;
                }
                Button {
                    text: Strings.ui_lock_create_choice;
                    clicked => { root.creating = true; }
                }
                Button {
                    text: Strings.ui_lock_connect_choice;
                    enabled: root.sync-available;
                    clicked => { root.show-sync = true; }
                }
                Text {
                    text: Strings.ui_lock_start_hint;
                    font-size: 11px;
                    color: #b8b2a2;
                    wrap: word-wrap;
                }
            }

            // New device that chose "create": set a master password.
            if !root.vault-exists && root.creating: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    npw := LineEdit {
                        placeholder-text: Strings.ui_lock_new_password_placeholder;
                        input-type: InputType.password;
                        accepted => { root.create-vault(self.text); }
                    }
                    Button {
                        text: Strings.ui_lock_create;
                        clicked => { root.create-vault(npw.text); }
                    }
                }
                Button {
                    text: Strings.ui_lock_back;
                    clicked => { root.creating = false; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

