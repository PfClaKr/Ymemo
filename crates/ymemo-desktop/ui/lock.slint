import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { PairingPanel, SharedDeviceRow } from "pairing.slint";
import { IconButton } from "theme.slint";

// ---------------------------------------------------------------------------
// Lock window: the master password prompt, hidden once unlocked.
// ---------------------------------------------------------------------------
export component LockWindow inherits Window {
    title: Strings.ui_lock_title;
    preferred-width: 320px;
    preferred-height: 300px;
    // A minimum rather than only a preference: a Window whose root is a layout is sized by
    // the layout, not by `preferred-width`, and the password prompt on its own is narrow
    // enough to wrap every line of the screen around it.
    min-width: 300px;
    // Tall enough for the first-run choice screen, hint line included; the panels that need
    // more than this say so through `recovery-shown` below.
    min-height: 250px;
    background: #2e2b27;

    in property <string> lock-message;
    in property <bool> sync-available: false;
    in property <string> my-pairing-code;
    in property <image> qr-image;
    in property <string> peer-message;
    in property <string> lan-pair-code;
    in property <string> lan-message;
    // Set while a peer registered from here has not allowed the request yet; the eight
    // characters its own screen shows, so the user can see the two agree.
    in property <string> pair-waiting-code;
    // Whether vault.json exists: true is an existing vault (unlock), false a new device
    // (choice screen). Rust flips it once pairing delivers vault.json.
    in property <bool> vault-exists: false;
    in property <[SharedDeviceRow]> shared-devices;
    // Whether this vault has a recovery code, read straight from vault.json: the lock
    // screen has to know before anything is unlocked.
    in property <bool> has-recovery: false;
    // A code just issued for a vault created on this device. Shown once, and only here —
    // nothing stores it, so the user has to write it down before moving on.
    in property <string> new-recovery-code;
    callback unlock(string);
    callback create-vault(string);
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);
    // Recovery code + the password to set with it.
    callback recover(string, string);
    // Deletes this device's vault outright. The last way out of a forgotten password.
    callback reset-vault();
    // The user says the recovery code is written down; Rust opens the vault.
    callback recovery-ack();
    // Fires as the pairing panel opens and closes; Rust grows the window to fit it and
    // shrinks it back.
    callback sync-toggled(bool);
    // Fires as a panel taller than the password prompt opens and closes; Rust grows the
    // window for it. A window that stayed at the prompt's height cut a freshly issued
    // recovery code off halfway through — on the one screen in the app whose whole job is
    // to be read and copied down.
    callback needs-room(bool);

    // in-out so Rust can close it when the vault arrives.
    in-out property <bool> show-sync: false;
    changed show-sync => { root.sync-toggled(self.show-sync); }
    // Whether a new device chose "create" and moved on to setting a password.
    private property <bool> creating: false;
    // Whether the "forgot the password" panel is open, and whether the wipe inside it has
    // been armed. Deleting every memo on the device takes two deliberate clicks.
    private property <bool> recovering: false;
    private property <bool> reset-armed: false;
    public function leave-recovery() {
        root.recovering = false;
        root.reset-armed = false;
    }
    // The two panels that do not fit the prompt's height: a new recovery code, and the
    // "forgot the password" panel with its code, its two fields and the wipe behind them.
    private property <bool> tall-panel: root.new-recovery-code != "" || root.recovering;
    changed tall-panel => { root.needs-room(self.tall-panel); }
    // Contents of the password field. The LineEdit sits inside a conditional block and
    // cannot be reached by id, so it is two-way bound here and cleared by Rust on lock.
    private property <string> password-text;
    public function clear-password() { root.password-text = ""; }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_list_heading;
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            IconButton {
                icon: "link";
                label: Strings.ui_list_tip_sync;
                clicked => { root.show-sync = !root.show-sync; }
            }
        }

        if root.show-sync: VerticalLayout {
            vertical-stretch: 1;
            PairingPanel {
                available: root.sync-available;
                my-code: root.my-pairing-code;
                qr: root.qr-image;
                message: root.peer-message;
                lan-code: root.lan-pair-code;
                lan-message: root.lan-message;
                waiting-code: root.pair-waiting-code;
                devices: root.shared-devices;
                ink: #d8d2c2;
                add-peer(code) => { root.add-peer(code); }
                lan-join(code) => { root.lan-join(code); }
                unshare(id) => { root.unshare(id); }
            }
            // Push the slack downwards so the panel stays at the top.
            Rectangle { vertical-stretch: 1; }
        }

        if !root.show-sync: VerticalLayout {
            spacing: 8px;
            if root.new-recovery-code == "": Text {
                text: root.lock-message;
                font-size: 12px;
                color: #e79a9a;
                wrap: word-wrap;
            }

            // Existing vault: unlock with the master password.
            if root.vault-exists && !root.recovering && root.new-recovery-code == "": VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: Strings.ui_lock_password_placeholder;
                        input-type: InputType.password;
                        text <=> root.password-text;
                        accepted => { root.unlock(self.text); }
                    }
                    Button {
                        text: Strings.ui_lock_open;
                        clicked => { root.unlock(root.password-text); }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Text {
                        text: Strings.ui_lock_forgot;
                        font-size: 11px;
                        color: #a8a294;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.recovering = true; }
                        }
                    }
                }
            }

            // Forgotten password: the recovery code, or starting over.
            if root.vault-exists && root.recovering: VerticalLayout {
                spacing: 8px;

                if root.has-recovery: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: Strings.ui_lock_recovery_prompt;
                        font-size: 11px;
                        color: #d8d2c2;
                        wrap: word-wrap;
                    }
                    code := LineEdit {
                        placeholder-text: Strings.ui_lock_recovery_placeholder;
                    }
                    newpw := LineEdit {
                        placeholder-text: Strings.ui_lock_recovery_new_password;
                        input-type: InputType.password;
                        accepted => { root.recover(code.text, self.text); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: Strings.ui_lock_recover;
                            primary: true;
                            enabled: code.text != "" && newpw.text != "";
                            clicked => { root.recover(code.text, newpw.text); }
                        }
                    }
                }
                if !root.has-recovery: Text {
                    text: Strings.ui_lock_no_recovery;
                    font-size: 11px;
                    color: #e8d98a;
                    wrap: word-wrap;
                }

                // Last resort. Nothing here can decrypt the memos, so the only other move
                // is to throw them away and start again.
                Rectangle { height: 1px; background: #4a453c; }
                Text {
                    text: Strings.ui_lock_reset_hint;
                    font-size: 10px;
                    color: #a8a294;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    if !root.reset-armed: Button {
                        text: Strings.ui_lock_reset;
                        clicked => { root.reset-armed = true; }
                    }
                    if root.reset-armed: Button {
                        text: Strings.ui_lock_reset_confirm;
                        primary: true;
                        clicked => { root.reset-vault(); }
                    }
                    Button {
                        text: Strings.ui_lock_back;
                        clicked => { root.leave-recovery(); }
                    }
                }
            }

            // First run on a new device: pick how to start.
            if !root.vault-exists && !root.creating && root.new-recovery-code == "": VerticalLayout {
                spacing: 8px;
                Text {
                    text: Strings.ui_lock_start_question;
                    font-size: 13px;
                    color: #f0ead6;
                    wrap: word-wrap;
                }
                Button {
                    text: Strings.ui_lock_create_choice;
                    clicked => { root.creating = true; }
                }
                Button {
                    text: Strings.ui_lock_connect_choice;
                    enabled: root.sync-available;
                    clicked => { root.show-sync = true; }
                }
                Text {
                    text: Strings.ui_lock_start_hint;
                    font-size: 11px;
                    color: #b8b2a2;
                    wrap: word-wrap;
                }
            }

            // New device that chose "create": set a master password.
            if !root.vault-exists && root.creating && root.new-recovery-code == "": VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    npw := LineEdit {
                        placeholder-text: Strings.ui_lock_new_password_placeholder;
                        input-type: InputType.password;
                        accepted => { root.create-vault(self.text); }
                    }
                    Button {
                        text: Strings.ui_lock_create;
                        clicked => { root.create-vault(npw.text); }
                    }
                }
                Button {
                    text: Strings.ui_lock_back;
                    clicked => { root.creating = false; }
                }
            }
            // A vault was just created: its recovery code, before anything else happens.
            if root.new-recovery-code != "": VerticalLayout {
                spacing: 8px;
                Text {
                    text: Strings.ui_lock_code_title;
                    font-size: 13px;
                    font-weight: 700;
                    color: #f0ead6;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: #3a362f;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e8d98a;
                    VerticalLayout {
                        padding: 10px;
                        // Selectable rather than a label, so it can be copied out.
                        TextInput {
                            text: root.new-recovery-code;
                            read-only: true;
                            font-size: 14px;
                            font-family: "monospace";
                            color: #f7e98c;
                            wrap: word-wrap;
                            single-line: false;
                        }
                    }
                }
                Text {
                    text: Strings.ui_lock_code_warning;
                    font-size: 10px;
                    color: #e8d98a;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Strings.ui_lock_code_saved;
                        primary: true;
                        clicked => { root.recovery-ack(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

