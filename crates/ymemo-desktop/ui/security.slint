import { LineEdit, Button, ScrollView, Palette as StdPalette } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Scroll, PrimaryButton, Field } from "theme.slint";

// ---------------------------------------------------------------------------
// Security window: change the master password, and issue the recovery code that is the
// only way back into a vault whose password is gone. Reached from the settings window.
//
// Both actions rewrite `vault.json` only. Nothing here re-encrypts memos, so neither is
// slow and neither disturbs the other devices; see crates/ymemo-core/src/vault.rs.
// ---------------------------------------------------------------------------
// The name of a field, kept above it rather than inside it: a `LineEdit`'s placeholder is
// gone the moment anything is typed, and three rows of dots with nothing to tell them apart
// is not a form anyone can check before pressing the button. Same reason as `lock.slint`.
component FieldLabel inherits Text {
    font-size: 10px;
    color: #a8a294;
}

// One of the window's two jobs, as a card — the same panels the settings window it opens
// from is made of, so the two read as one place rather than a form behind a dashboard.
component Section inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    background: #36322d;
    border-radius: 10px;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            color: #d8c765;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 10px;
            color: #a8a294;
            wrap: word-wrap;
        }
        @children
    }
}

export component SecurityWindow inherits Window {
    default-font-family: "Pretendard";
    // This window is always dark, so the standard controls in it are too. Left to follow the
    // system they came out light on a light-mode desktop — pale grey boxes set into a dark
    // window, and a disabled primary button drawn darker than an enabled one beside it.
    init => { StdPalette.color-scheme = ColorScheme.dark; }
    title: Strings.ui_security_title;
    preferred-width: 400px;
    preferred-height: 530px;
    min-width: 340px;
    // See settings.slint: a Window whose root is a layout takes that layout's size, and the
    // wrapping hints measure themselves against no width while it is being decided. This
    // window opened 1472px tall, with the close button below the bottom of the screen.
    min-height: 510px;
    background: #2e2b27;

    // Whether a recovery code was ever issued for this vault.
    in property <bool> has-recovery: false;
    // A freshly issued code. Non-empty only until the window closes: this is the one moment
    // it is readable, since only its Argon2id wrapper is stored.
    in property <string> recovery-code;
    in property <string> status;
    in property <bool> status-is-error: false;
    // Which section the message belongs under. A single line at the foot of the window sat
    // below the recovery section and a one-time code, so "Wrong password" appeared 150px
    // under the button that produced it, next to a button it had nothing to do with.
    in property <bool> status-on-password: true;

    callback change-password(string, string); // current, new
    callback issue-recovery();
    callback close-requested();

    // Cleared by Rust after a successful change, so the passwords do not linger on screen.
    property <string> current-pw;
    property <string> new-pw;
    property <string> confirm-pw;
    public function clear-passwords() {
        root.current-pw = "";
        root.new-pw = "";
        root.confirm-pw = "";
    }
    // The button stays out of reach until the two new entries agree, which catches the
    // typo that would otherwise lock the user out of their own vault.
    private property <bool> can-change:
        root.current-pw != "" && root.new-pw.character-count >= root.min-password
            && root.new-pw == root.confirm-pw;
    // Whether the code on screen has been put on the clipboard; a new code is a new thing to copy.
    private property <bool> code-copied: false;
    changed recovery-code => { self.code-copied = false; }
    // Whether the recovery button has been pressed once over an existing code.
    in-out property <bool> confirm-reissue: false;
    // Shortest new password accepted; set from `ymemo_core::crypto::MIN_PASSWORD_CHARS`.
    in property <int> min-password: 8;

    // Escape closes this window, the way it closes the folder-name box and puts a
    // note down. A `FocusScope` around the whole of it rather than a handler on one
    // control: Slint sends a key to the focused item first and then up through its
    // ancestors, so this is reached whatever the user last clicked into.
    keys := FocusScope {
        // Nothing has the focus in a window that has just opened, so it takes it;
        // anything clicked into takes it away and gets its keys first.
        init => { self.focus(); }
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            Text {
                text: Strings.ui_security_heading;
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
            }

            // Scrolls, and gives its content an explicit width so the wrapping hints inside can
            // measure themselves; the close button below stays put.
            scroll := ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: content.preferred-height;

                content := VerticalLayout {
                    width: scroll.visible-width - Scroll.gutter;
                    spacing: 14px;

                    // ---- Master password ----
                    Section {
                        label: Strings.ui_security_change_password;
                        hint: Strings.ui_security_password_hint;
                        FieldLabel { text: Strings.ui_security_current_password; }
                        // Return walks down the three fields, as on the lock window.
                        Field {
                            input-type: InputType.password;
                            text <=> root.current-pw;
                            accepted => { new-field.focus(); }
                        }
                        FieldLabel { text: Strings.ui_security_new_password; }
                        new-field := Field {
                            input-type: InputType.password;
                            text <=> root.new-pw;
                            accepted => { confirm-field.focus(); }
                        }
                        FieldLabel { text: Strings.ui_security_confirm_password; }
                        confirm-field := Field {
                            input-type: InputType.password;
                            text <=> root.confirm-pw;
                            accepted => {
                                if (root.can-change) { root.change-password(root.current-pw, root.new-pw); }
                            }
                        }
                        if root.new-pw != "" && root.new-pw.character-count < root.min-password: Text {
                            text: Strings.ui_password_too_short;
                            font-size: 10px;
                            color: #e79a9a;
                        }
                        if root.new-pw.character-count >= root.min-password && root.confirm-pw != "" && root.new-pw != root.confirm-pw: Text {
                            text: Strings.ui_security_mismatch;
                            font-size: 10px;
                            color: #e79a9a;
                        }
                        // At the right end, as the main button is in every other window.
                        HorizontalLayout {
                            alignment: end;
                            PrimaryButton {
                                text: Strings.ui_security_change_button;
                                enabled: root.can-change;
                                clicked => { root.change-password(root.current-pw, root.new-pw); }
                            }
                        }
                        if root.status != "" && root.status-on-password: Text {
                            text: root.status;
                            font-size: 11px;
                            color: root.status-is-error ? #e79a9a : #a8d0a8;
                            wrap: word-wrap;
                        }
                    }

                    // ---- Recovery code ----
                    Section {
                        label: Strings.ui_security_recovery;
                        hint: Strings.ui_security_recovery_hint;
                        Text {
                            text: root.has-recovery
                                ? Strings.ui_security_recovery_present
                                : Strings.ui_security_recovery_absent;
                            font-size: 11px;
                            color: root.has-recovery ? #a8d0a8 : #e8d98a;
                            wrap: word-wrap;
                        }

                        // Issuing again kills the code already written down, so with one on
                        // record the first click only asks.
                        if root.confirm-reissue: Text {
                            text: Strings.ui_security_reissue_warning;
                            font-size: 11px;
                            color: #e79a9a;
                            wrap: word-wrap;
                        }
                        // The way back first and the action at the right end. No code yet:
                        // issuing one is what this card is asking for, so it is the gold
                        // button. Reissuing is a quiet button until it asks for confirmation,
                        // and then red — the old code stops working, and that is not undone.
                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            if root.confirm-reissue: Button {
                                text: Strings.ui_security_reissue_cancel;
                                clicked => { root.confirm-reissue = false; }
                            }
                            if root.has-recovery && !root.confirm-reissue: Button {
                                text: Strings.ui_security_reissue_button;
                                clicked => { root.confirm-reissue = true; }
                            }
                            if !root.has-recovery || root.confirm-reissue: PrimaryButton {
                                text: root.has-recovery
                                    ? Strings.ui_security_reissue_button
                                    : Strings.ui_security_issue_button;
                                danger: root.confirm-reissue;
                                clicked => {
                                    root.confirm-reissue = false;
                                    root.issue-recovery();
                                }
                            }
                        }
                        if root.status != "" && !root.status-on-password: Text {
                            text: root.status;
                            font-size: 11px;
                            color: root.status-is-error ? #e79a9a : #a8d0a8;
                            wrap: word-wrap;
                        }
                    }

                    // The code itself, shown once. The window grows to make room for it —
                    // see `show` in security.rs; a window sized for the two sections alone
                    // left it under the fold, so the screen said a code had been issued and
                    // then did not show it.
                    if root.recovery-code != "": VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            background: #3a362f;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #e8d98a;
                            VerticalLayout {
                                padding: 12px;
                                code-field := TextInput {
                                    text: root.recovery-code;
                                    read-only: true;
                                    font-size: 15px;
                                    font-family: "monospace";
                                    color: #f7e98c;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    single-line: false;
                                }
                            }
                        }
                        Text {
                            text: Strings.ui_security_code_warning;
                            font-size: 10px;
                            color: #e8d98a;
                            wrap: word-wrap;
                        }
                        // The same button the lock window has under a new vault's code: this is
                        // a 39-character code shown once, and transcribing it is where it goes
                        // wrong. Copied through the field's own selection, like there.
                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: root.code-copied ? Strings.ui_lock_code_copied : Strings.ui_lock_code_copy;
                                clicked => {
                                    code-field.select-all();
                                    code-field.copy();
                                    code-field.clear-selection();
                                    root.code-copied = true;
                                }
                            }
                        }
                    }

                }
            }

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: Strings.ui_security_close;
                    clicked => { root.close-requested(); }
                }
            }
        }
    }
}
