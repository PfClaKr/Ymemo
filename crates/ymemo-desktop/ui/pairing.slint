import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, TabButton } from "theme.slint";

// 기기 페어링 패널.
//  - 기본: 같은 네트워크에서 6자리 코드로 연결 (이 기기 코드 표시 + 상대 코드 입력).
//  - 접이식 폴백: QR / 긴 device-id 직접 등록 (다른 네트워크용).
// 현재 이 vault 를 공유 중인 다른 기기 한 대.
export struct SharedDeviceRow {
    id: string,        // syncthing device-id (해제 시 식별자)
    name: string,      // 사람이 읽을 이름 (없으면 빈 문자열 → id 축약 표시)
    connected: bool,   // 지금 연결돼 있는지
}

export component PairingPanel inherits VerticalLayout {
    in property <bool> available;
    in property <string> my-code;          // 이 기기의 긴 device-id 코드 (폴백)
    in property <image> qr;
    in property <string> message;          // 수동 등록 결과
    in property <string> lan-code;         // 이 기기의 현재 6자리 코드
    in property <string> lan-message;      // LAN 연결 결과
    in property <[SharedDeviceRow]> devices;  // 현재 공유 중인 기기들
    in property <color> ink: #5c5c25;
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);              // 인자: 해제할 device-id

    // 지금 보고 있는 탭. false = 같은 Wi-Fi(6자리), true = 다른 네트워크(QR·device-id).
    private property <bool> remote: false;

    spacing: 8px;

    if root.available: VerticalLayout {
        spacing: 8px;
        Text {
            text: Strings.ui_pair_title;
            font-size: 13px;
            font-weight: 700;
            color: root.ink;
        }

        // ---- 연결 방식 탭 ----
        HorizontalLayout {
            TabButton {
                label: Strings.ui_pair_tab_lan;
                active: !root.remote;
                ink: root.ink;
                clicked => { root.remote = false; }
            }
            TabButton {
                label: Strings.ui_pair_tab_remote;
                active: root.remote;
                ink: root.ink;
                clicked => { root.remote = true; }
            }
        }

        // ---- 방식 1: 같은 네트워크 — 6자리 코드 ----
        if !root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_lan_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            // 이 기기의 6자리 코드 (크게).
            Text {
                text: root.lan-code == "" ? "------" : root.lan-code;
                font-size: 26px;
                font-weight: 800;
                letter-spacing: 3px;
                color: root.ink;
                horizontal-alignment: center;
            }
            // 상대 코드 입력 → LAN 연결.
            HorizontalLayout {
                spacing: 6px;
                lan := LineEdit {
                    placeholder-text: Strings.ui_pair_lan_placeholder;
                    input-type: InputType.number;
                    accepted => { root.lan-join(self.text); self.text = ""; }
                }
                Button {
                    text: Strings.ui_pair_lan_connect;
                    clicked => { root.lan-join(lan.text); lan.text = ""; }
                }
            }
            if root.lan-message != "": Text {
                text: root.lan-message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }
        }

        // ---- 방식 2 (폴백): 다른 네트워크 — QR / 긴 device-id ----
        if root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_remote_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            Image {
                source: root.qr;
                width: 120px;
                height: 120px;
                image-rendering: pixelated;
            }
            Text {
                text: root.my-code;
                font-size: 9px;
                color: root.ink;
                opacity: 0.75;
                wrap: char-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                peer := LineEdit {
                    placeholder-text: Strings.ui_pair_remote_placeholder;
                    accepted => { root.add-peer(self.text); }
                }
                Button {
                    text: Strings.ui_pair_remote_register;
                    clicked => { root.add-peer(peer.text); }
                }
            }
            if root.message != "": Text {
                text: root.message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }
        }

        // ---- 현재 공유 중인 기기 목록 (탭과 무관하게 항상 보인다) ----
        Rectangle { height: 1px; background: root.ink; opacity: 0.25; }
        Text {
            text: Strings.ui_pair_devices_title;
            font-size: 12px;
            font-weight: 700;
            color: root.ink;
        }
        if root.devices.length == 0: Text {
            text: Strings.ui_pair_devices_empty;
            font-size: 11px;
            color: root.ink;
            opacity: 0.7;
        }
        for dev in root.devices: HorizontalLayout {
            spacing: 6px;
            // 연결 상태 점.
            Text {
                text: dev.connected ? "●" : "○";
                font-size: 11px;
                color: dev.connected ? #6fae6f : root.ink;
                vertical-alignment: center;
            }
            Text {
                text: dev.name;
                font-size: 11px;
                color: root.ink;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: Strings.ui_pair_unshare;
                clicked => { root.unshare(dev.id); }
            }
        }
    }
    if !root.available: Text {
        text: Strings.ui_pair_unavailable;
        font-size: 12px;
        color: #d98a8a;
        wrap: word-wrap;
    }
}
