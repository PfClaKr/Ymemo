import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, TabButton } from "theme.slint";

// Device pairing panel.
//  - Default: a 6-digit code on the same network (ours shown, theirs entered).
//  - Fallback: QR or a pasted device id, for devices on different networks.
//
// The fallback path only ever does *this* device's half: registering a peer starts dialling
// it, and nothing syncs until that device allows the request. `waiting-code` is what says so
// — the same eight characters the other device shows on its approval window.
// One other device currently sharing this vault.
export struct SharedDeviceRow {
    id: string,        // syncthing device id, also the unshare handle
    name: string,      // human-readable name; empty falls back to a shortened id
    connected: bool,
}

export component PairingPanel inherits VerticalLayout {
    in property <bool> available;
    in property <string> my-code;          // this device's full pairing code (fallback)
    in property <image> qr;
    in property <string> message;          // result of a manual registration
    in property <string> lan-code;         // this device's current 6-digit code
    in property <string> lan-message;      // result of a LAN connection
    // Verification code while a registered peer has not answered yet; empty when not waiting.
    in property <string> waiting-code;
    in property <[SharedDeviceRow]> devices;  // devices sharing the vault
    in property <color> ink: #5c5c25;
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);              // device id to unshare
    // Whether removing a device is offered at all.
    //
    // False on the lock screen, where there is no open vault to record the decision in — and
    // a removal that is not recorded does not hold: the other devices still have the peer and
    // introduce it straight back. Better to not offer it than to offer something that quietly
    // undoes itself. The list window, which only exists once the vault is open, offers it.
    in property <bool> can-unshare: true;

    // Active tab: false is same Wi-Fi (6 digits), true is another network (QR, device id).
    private property <bool> remote: false;
    // The device whose removal is waiting for a second click; empty when none is. A removal
    // is written into the synced document and only a fresh pairing undoes it, so one stray
    // click must not be enough.
    private property <string> confirm-id;
    // Whether the pairing code was just put on the clipboard.
    private property <bool> copied: false;
    // "Copied" says so for a moment and goes back, rather than until the window closes.
    copied-timer := Timer {
        interval: 2s;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    spacing: 8px;

    if root.available: VerticalLayout {
        spacing: 8px;
        Text {
            text: Strings.ui_pair_title;
            font-size: 13px;
            font-weight: 700;
            color: root.ink;
        }

        // ---- Method tabs ----
        HorizontalLayout {
            TabButton {
                label: Strings.ui_pair_tab_lan;
                active: !root.remote;
                ink: root.ink;
                clicked => { root.remote = false; }
            }
            TabButton {
                label: Strings.ui_pair_tab_remote;
                active: root.remote;
                ink: root.ink;
                clicked => { root.remote = true; }
            }
        }

        // ---- Method 1: same network, 6-digit code ----
        if !root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_lan_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            // Why there is no code, when there is none. The listener binds one fixed UDP
            // port — it has to, since that is what the other device broadcasts to — so
            // anything else holding it leaves this device unable to *offer* a code. Joining
            // with the other device's code still works, and saying so keeps the half that
            // works usable instead of showing a dead row of dashes.
            if root.available && root.lan-code == "": Text {
                text: Strings.ui_pair_lan_no_code;
                font-size: 10px;
                color: #d9b48a;
                wrap: word-wrap;
            }
            // This device's code, large.
            if root.lan-code != "": Text {
                text: root.lan-code;
                font-size: 26px;
                font-weight: 800;
                letter-spacing: 3px;
                color: root.ink;
                horizontal-alignment: center;
            }
            // Enter their code to connect over the LAN.
            HorizontalLayout {
                spacing: 6px;
                lan := LineEdit {
                    placeholder-text: Strings.ui_pair_lan_placeholder;
                    input-type: InputType.number;
                    // Six digits or nothing: anything else only failed after the whole
                    // network wait, with nothing on screen saying why.
                    accepted => {
                        if (self.text.character-count == 6) {
                            root.lan-join(self.text);
                            self.text = "";
                        }
                    }
                }
                Button {
                    text: Strings.ui_pair_lan_connect;
                    enabled: lan.text.character-count == 6;
                    clicked => { root.lan-join(lan.text); lan.text = ""; }
                }
            }
            if root.lan-message != "": Text {
                text: root.lan-message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }
        }

        // ---- Method 2 (fallback): another network, QR or device id ----
        if root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_remote_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            Image {
                source: root.qr;
                width: 120px;
                height: 120px;
                image-rendering: pixelated;
            }
            // A read-only field rather than a Text, so the code can be selected — and the
            // button copies it whole, since it is only useful pasted somewhere else.
            HorizontalLayout {
                spacing: 6px;
                code := TextInput {
                    text: root.my-code;
                    read-only: true;
                    single-line: false;
                    font-size: 9px;
                    color: root.ink;
                    opacity: 0.75;
                    wrap: char-wrap;
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.copied ? Strings.ui_pair_copied : Strings.ui_pair_copy;
                    clicked => {
                        code.select-all();
                        code.copy();
                        code.clear-selection();
                        root.copied = true;
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                peer := LineEdit {
                    placeholder-text: Strings.ui_pair_remote_placeholder;
                    accepted => { root.add-peer(self.text); }
                }
                Button {
                    text: Strings.ui_pair_remote_register;
                    clicked => { root.add-peer(peer.text); }
                }
            }
            if root.message != "": Text {
                text: root.message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }

            // Waiting to be let in by the device whose code was just entered.
            if root.waiting-code != "": VerticalLayout {
                spacing: 4px;
                Rectangle { height: 1px; background: root.ink; opacity: 0.25; }
                Text {
                    text: Strings.ui_pair_waiting;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.ink;
                    wrap: word-wrap;
                }
                Text {
                    text: Strings.ui_pair_verification;
                    font-size: 10px;
                    color: root.ink;
                    opacity: 0.8;
                }
                Text {
                    text: root.waiting-code;
                    font-size: 22px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    color: root.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: Strings.ui_pair_waiting_hint;
                    font-size: 10px;
                    color: root.ink;
                    opacity: 0.8;
                    wrap: word-wrap;
                }
            }
        }

        // ---- Shared devices, always visible regardless of tab ----
        Rectangle { height: 1px; background: root.ink; opacity: 0.25; }
        Text {
            text: Strings.ui_pair_devices_title;
            font-size: 12px;
            font-weight: 700;
            color: root.ink;
        }
        if root.devices.length == 0: Text {
            text: Strings.ui_pair_devices_empty;
            font-size: 11px;
            color: root.ink;
            opacity: 0.7;
        }
        for dev in root.devices: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                // Connection dot: filled while the device is reachable, an outline while it
                // is not. A shape rather than ●/○, so it cannot depend on the font the
                // platform happens to fall back to.
                Rectangle {
                    width: 9px;
                    height: 9px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: dev.connected ? #6fae6f : #0000;
                    border-width: dev.connected ? 0px : 1.5px;
                    border-color: root.ink;
                }
                Text {
                    text: dev.name;
                    font-size: 11px;
                    color: root.ink;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.can-unshare && root.confirm-id != dev.id: Button {
                    text: Strings.ui_pair_unshare;
                    clicked => { root.confirm-id = dev.id; }
                }
                if root.can-unshare && root.confirm-id == dev.id: Button {
                    text: Strings.ui_pair_unshare_cancel;
                    clicked => { root.confirm-id = ""; }
                }
                if root.can-unshare && root.confirm-id == dev.id: Button {
                    text: Strings.ui_pair_unshare;
                    primary: true;
                    clicked => {
                        root.confirm-id = "";
                        root.unshare(dev.id);
                    }
                }
            }
            if root.confirm-id == dev.id: Text {
                text: Strings.ui_pair_unshare_warning;
                font-size: 10px;
                color: #d98a8a;
                wrap: word-wrap;
            }
        }
    }
    if !root.available: Text {
        text: Strings.ui_pair_unavailable;
        font-size: 12px;
        color: #d98a8a;
        wrap: word-wrap;
    }
}
