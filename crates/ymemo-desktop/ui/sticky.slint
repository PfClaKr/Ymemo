import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette } from "theme.slint";

// ---------------------------------------------------------------------------
// Sticky window: one frameless window per memo.
//  - Drag the title bar to move it (handled by Rust, with snapping on X11).
//  - Double-click the title bar to fold it to a thin bar.
//  - Palette, new memo, and close (which does not delete).
// ---------------------------------------------------------------------------
/// One photo on a sticky, filled in by Rust.
///
/// Sizes arrive in pixels: the core syncs a width in em, and Rust converts it against this
/// window's body font. The position arrives as a **fraction of the note** instead, and is
/// turned into pixels here, so resizing the window keeps a photo on the same part of the
/// note without a round trip through Rust.
export struct PhotoRow {
    id: string,
    image: image,
    width-px: length,
    height-px: length,
    x-frac: float,
    y-frac: float,
    // Not synced to this device yet, or undecodable.
    missing: bool,
}

// ---------------------------------------------------------------------------
// One photo lying on the note: drag it anywhere, pull its corner to resize, ✕ to detach.
//
// It floats over the text rather than taking a column of its own, so a note is a note with
// pictures on it and not a note stapled to a gallery. Nothing here is committed until the
// pointer is released — a drag would otherwise leave one log entry per mouse move.
// ---------------------------------------------------------------------------
component PhotoItem inherits Rectangle {
    in property <PhotoRow> photo;
    in property <length> canvas-w;
    in property <length> canvas-h;
    in property <string> color-key;
    // x and y as a fraction of the note, and the width in px.
    callback place(float, float, length);
    callback remove();
    // Raised while a pointer is down on this photo, so a merge landing mid-drag does not
    // replace the model underneath and drop the drag.
    callback busy(bool);

    // Smallest a photo may be pulled, and how big the corner that resizes instead of moves
    // is. Below the one the handles would cover the whole picture; below the other the
    // corner would be too small to hit.
    private property <length> min-w: 44px;
    private property <length> grip: 18px;
    // Live offsets while a pointer is down, folded into the stored geometry on release.
    private property <length> dx: 0px;
    private property <length> dy: 0px;
    private property <length> dw: 0px;
    // Absolute pointer position when the drag began. Deltas are measured against this rather
    // than against the touch area, whose own coordinates travel with the photo and would
    // feed the drag back into itself.
    private property <length> grab-x: 0px;
    private property <length> grab-y: 0px;
    private property <bool> dragging: false;
    private property <bool> resizing: false;
    // Whether the pointer is on the corner rather than the picture; decides both the cursor
    // and what the next press will do.
    private property <bool> on-grip: move-ta.mouse-x > root.width - root.grip
        && move-ta.mouse-y > root.height - root.grip;
    private property <bool> active: root.dragging || move-ta.has-hover || close-ta.has-hover;

    private property <length> w: Math.min(Math.max(root.photo.width-px + root.dw, root.min-w),
        Math.max(root.canvas-w, root.min-w));
    // Keep the original proportions; the width is the only size the core syncs.
    private property <length> h: root.photo.height-px <= 0px || root.photo.width-px <= 0px
        ? root.w
        : root.w * (root.photo.height-px / root.photo.width-px);

    // Never fully off the note: a photo whose corner cannot be reached cannot be brought back.
    x: Math.min(Math.max(root.photo.x-frac * root.canvas-w + root.dx, 0px),
        Math.max(root.canvas-w - root.w, 0px));
    y: Math.min(Math.max(root.photo.y-frac * root.canvas-h + root.dy, 0px),
        Math.max(root.canvas-h - root.h, 0px));
    width: root.w;
    height: root.h;
    // The note sizes itself from its text alone. Without this the photos would push it wider
    // and taller, and a note size that depends on the photos that depend on the note size is
    // the binding loop Slint refuses to resolve.
    preferred-width: 0px;
    preferred-height: 0px;

    function begin(ax: length, ay: length, grip: bool) {
        root.grab-x = ax;
        root.grab-y = ay;
        root.resizing = grip;
        root.dragging = true;
        root.busy(true);
    }
    function commit() {
        root.dragging = false;
        root.busy(false);
        // Read the clamped geometry back, so what is stored is where the photo actually is
        // and not where the pointer went.
        root.place(root.x / Math.max(root.canvas-w, 1px), root.y / Math.max(root.canvas-h, 1px),
            root.w);
        root.dx = 0px;
        root.dy = 0px;
        root.dw = 0px;
    }

    // A frame in the note's own ink, so a pale photo does not bleed into the paper.
    border-width: root.active ? 2px : 1px;
    border-color: root.active
        ? Palette.ink(root.color-key)
        : Palette.ink(root.color-key).with-alpha(0.35);
    background: Palette.bar(root.color-key);
    clip: true;

    if !root.photo.missing: Image {
        width: 100%;
        height: 100%;
        source: root.photo.image;
        image-fit: contain;
    }
    if root.photo.missing: Text {
        width: 100%;
        height: 100%;
        text: Strings.ui_sticky_photo_missing;
        font-size: 10px;
        color: Palette.ink(root.color-key);
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // One touch area for the whole photo, splitting move from resize by where the press
    // landed. Handles with touch areas of their own would have to appear before they can be
    // pressed, and something that only exists once you are already on it is not a handle.
    move-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.on-grip ? MouseCursor.nwse-resize : MouseCursor.move;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.begin(self.absolute-position.x + self.mouse-x,
                           self.absolute-position.y + self.mouse-y,
                           root.on-grip);
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                root.commit();
            }
        }
        moved => {
            if (root.resizing) {
                // Width only; the height follows the original aspect ratio.
                root.dw = self.absolute-position.x + self.mouse-x - root.grab-x;
            } else {
                root.dx = self.absolute-position.x + self.mouse-x - root.grab-x;
                root.dy = self.absolute-position.y + self.mouse-y - root.grab-y;
            }
        }
    }

    // Detach. Disabled until the photo is under the pointer, so the first move onto this
    // corner reaches the area below and reveals the button instead of pressing an invisible
    // one; from then on this sits on top and keeps the photo active by itself.
    close-ta := TouchArea {
        x: parent.width - self.width - 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        enabled: root.active;
        clicked => { root.remove(); }
    }

    // ---- Furniture, painted only while the photo is under the pointer so the picture is
    // not permanently covered by its own controls. Plain shapes: the areas above do the
    // hit-testing. ----
    if root.active: Rectangle {
        x: close-ta.x;
        y: close-ta.y;
        width: close-ta.width;
        height: close-ta.height;
        border-radius: self.width / 2;
        background: close-ta.has-hover ? #d64541 : #000000a8;
        Text {
            width: 100%;
            height: 100%;
            text: "✕";
            font-size: 11px;
            font-weight: 700;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.active: Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: root.grip;
        height: root.grip;
        background: root.on-grip ? Palette.ink(root.color-key) : #000000a8;
        Text {
            width: 100%;
            height: 100%;
            text: "⇲";
            font-size: 11px;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One button on the sticky's title bar: a glyph in the bar's own ink, which stays legible
// on every pastel where an emoji falling back to a monochrome default would not.
component BarButton inherits TouchArea {
    in property <string> glyph;
    in property <string> color-key;
    in property <length> glyph-size: 13px;
    in property <float> rest-opacity: 0.6;

    width: 26px;
    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-size: root.glyph-size;
        font-weight: 700;
        color: Palette.ink(root.color-key);
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.has-hover ? 1 : root.rest-opacity;
    }
}

export component StickyWindow inherits Window {
    title: root.memo-title == "" ? Strings.ui_sticky_window_title : root.memo-title;
    no-frame: true;
    always-on-top: true;
    background: #0000;
    preferred-width: 260px;
    preferred-height: 240px;
    min-width: 160px;
    min-height: 28px;
    resize-border-width: 4px;

    in property <string> memo-title;
    in-out property <string> memo-text;
    in property <string> sticky-color: "yellow";
    // Window opacity in percent; in-out because the slider previews it live.
    in-out property <float> sticky-opacity: 100;
    in property <bool> collapsed: false;
    in property <[PhotoRow]> photos: [];
    // True while a photo is being dragged or resized. Rust reads it before pushing a merged
    // photo list in, the way `dirty` protects text the user is still typing.
    out property <bool> photo-busy: false;
    callback edited(string);
    // Attach a photo; Rust opens the file dialog.
    callback add-photo();
    callback show-history();
    // Move and resize in one go: x and y as a fraction of the note, width in px.
    callback place-photo(string, float, float, length);
    // Detach a photo. The blob stays; only this memo stops showing it.
    callback remove-photo(string);
    callback close-requested();
    callback new-memo();
    callback set-color(string);
    callback set-opacity(float);
    callback toggle-collapse();
    // Title bar drag: we follow the pointer ourselves rather than leaving it to the OS, so
    // snapping happens during the drag and not only on release. All arguments are logical px
    // relative to the window's top-left corner.
    //   begin-drag takes the grab point; where window coordinates are unavailable (native
    //   Wayland) Rust falls back to the OS move and returns false, ending the tracking.
    callback begin-drag(float, float) -> bool;
    callback drag-move(float, float);   // current pointer position
    callback drag-end();

    // Creation time, already formatted by Rust; empty until it is set.
    in property <string> created-at;
    private property <bool> show-palette: false;
    // Whether this press became a drag, and whether we are tracking it ourselves.
    private property <bool> drag-started: false;
    private property <bool> drag-manual: false;

    public function focus-body() { body.focus(); }

    // Folding hides everything but the title, so anything open below it has to fold away too
    // — a colour panel left standing would be all that is left of the note.
    changed collapsed => {
        if (self.collapsed) { self.show-palette = false; }
    }

    Rectangle {
        background: Palette.bg(root.sticky-color);
        // Square corners.
        border-radius: 0px;
        border-width: 1px;
        border-color: Palette.bar(root.sticky-color).darker(0.15);
        clip: true;
        // Fade the whole window, text included, so the desktop shows through.
        opacity: root.sticky-opacity / 100;

        VerticalLayout {
            // ---- Title bar: drag handle and fold toggle ----
            Rectangle {
                // Must match BAR_HEIGHT in sticky.rs, the folded window height.
                height: 28px;
                background: Palette.bar(root.sticky-color);

                bar-ta := TouchArea {
                    moved => {
                        // Over 4px counts as a drag, so clicks are not misread.
                        if (!root.drag-started
                            && (self.mouse-x > self.pressed-x + 4px || self.mouse-x < self.pressed-x - 4px
                                || self.mouse-y > self.pressed-y + 4px || self.mouse-y < self.pressed-y - 4px)) {
                            root.drag-started = true;
                            root.drag-manual = root.begin-drag(self.pressed-x / 1px, self.pressed-y / 1px);
                        }
                        if (root.drag-manual) {
                            root.drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            if (root.drag-manual) { root.drag-end(); }
                            root.drag-started = false;
                            root.drag-manual = false;
                        }
                    }
                    double-clicked => { root.toggle-collapse(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 2px;
                    Text {
                        text: root.memo-title == "" ? Strings.ui_sticky_default_title : root.memo-title;
                        font-size: 13px;
                        font-weight: 700;
                        color: Palette.ink(root.sticky-color);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    // Folded, the window is one bar tall and everything these buttons open —
                    // the file dialog, the history window, the colour panel — either lands on
                    // a note that is not there or reopens it behind the user's back. Only the
                    // unfold (double-click) and the close stay.
                    if !root.collapsed: photo-ta := TouchArea {
                        width: 26px;
                        // Drawn, not 📎: an emoji needs an emoji font, and where there is
                        // none the glyph falls back to the default text colour and is all
                        // but invisible on these pastel bars — the same reason the colour
                        // chip below is a shape rather than a character.
                        Rectangle {
                            width: 16px;
                            height: 13px;
                            border-width: 1.5px;
                            border-color: Palette.ink(root.sticky-color);
                            clip: true;
                            opacity: photo-ta.has-hover ? 1 : 0.75;
                            Rectangle {
                                x: 2.5px;
                                y: 2px;
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: Palette.ink(root.sticky-color);
                            }
                            Path {
                                x: 1.5px;
                                y: 4px;
                                width: 13px;
                                height: 7px;
                                viewbox-width: 12;
                                viewbox-height: 6;
                                commands: "M 0 6 L 4 1 L 6.5 3.5 L 8.5 2 L 12 6 Z";
                                fill: Palette.ink(root.sticky-color);
                            }
                        }
                        clicked => { root.add-photo(); }
                    }
                    if !root.collapsed: BarButton {
                        glyph: "⟲";
                        color-key: root.sticky-color;
                        glyph-size: 15px;
                        clicked => { root.show-history(); }
                    }
                    if !root.collapsed: palette-ta := TouchArea {
                        width: 26px;
                        // A chip of the memo's own colour, not an emoji: an emoji that falls
                        // back to a monochrome glyph is drawn in the default text colour,
                        // which on these pastel bars is all but invisible. A filled circle
                        // with the title bar's ink around it reads at any colour, and says
                        // what it will change at the same time.
                        Rectangle {
                            width: 15px;
                            height: 15px;
                            border-radius: 8px;
                            background: Palette.swatch(root.sticky-color);
                            border-width: 1.5px;
                            border-color: Palette.ink(root.sticky-color);
                            opacity: palette-ta.has-hover ? 1 : 0.85;
                        }
                        clicked => { root.show-palette = !root.show-palette; }
                    }
                    if !root.collapsed: BarButton {
                        glyph: "＋";
                        color-key: root.sticky-color;
                        glyph-size: 14px;
                        rest-opacity: 0.55;
                        clicked => { root.new-memo(); }
                    }
                    // Close: the one button that must never be hunted for. The ink alone
                    // disappeared into the pastel bar, so it sits on a chip of its own —
                    // dark at rest, red under the pointer, white glyph on both.
                    close-ta := TouchArea {
                        width: 26px;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: close-ta.has-hover ? #d64541 : Palette.ink(root.sticky-color);
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // ---- Color and opacity panel. It stays open after a pick, since the two are
            // usually adjusted together. ----
            if root.show-palette && !root.collapsed: Rectangle {
                height: 72px;
                background: Palette.bar(root.sticky-color).darker(0.06);
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: Palette.swatch(key);
                            border-width: root.sticky-color == key ? 3px : 1px;
                            border-color: root.sticky-color == key ? #ffffff : #00000040;
                            chip := TouchArea {
                                clicked => { root.set-color(key); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: Strings.ui_sticky_opacity;
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 20; // matches the core's MIN_OPACITY
                            maximum: 100;
                            value: root.sticky-opacity;
                            // Preview while dragging, store once on release.
                            changed(v) => { root.sticky-opacity = v; }
                            released(v) => { root.set-opacity(v); }
                        }
                        Text {
                            text: Math.round(root.sticky-opacity) + "%";
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 34px;
                        }
                    }
                }
            }

            // ---- The note: text with the photos lying on top of it. One surface, not two
            // panes — a photo is placed where the writing leaves room for it, and the note
            // keeps every pixel of the window the photos are not covering. ----
            note := Rectangle {
                visible: !root.collapsed;
                vertical-stretch: 1;
                // Zero while folded, or this minimum would stop the window from shrinking to
                // the title bar.
                min-height: root.collapsed ? 0px : 96px;
                clip: true;

                body := TextEdit {
                    width: 100%;
                    height: 100%;
                    font-size: 13px;
                    wrap: word-wrap;
                    text <=> root.memo-text;
                    edited => { root.edited(self.text); }
                }

                // Declared after the text, so a photo is picked up by a click on it rather
                // than placing the caret underneath.
                for photo in root.photos: PhotoItem {
                    photo: photo;
                    canvas-w: note.width;
                    canvas-h: note.height;
                    color-key: root.sticky-color;
                    place(fx, fy, w) => { root.place-photo(photo.id, fx, fy, w); }
                    remove => { root.remove-photo(photo.id); }
                    busy(b) => { root.photo-busy = b; }
                }
            }
        }

        // ---- Created-at, along the bottom edge. Declared last so it paints over the body
        // rather than under it, laid out by hand so it takes no line from the note, and
        // faint enough to read straight past. ----
        if !root.collapsed && root.created-at != "": Text {
            text: root.created-at;
            font-size: 9px;
            color: Palette.ink(root.sticky-color);
            opacity: 0.45;
            x: parent.width - self.width - 7px;
            y: parent.height - self.height - 4px;
        }
    }
}
