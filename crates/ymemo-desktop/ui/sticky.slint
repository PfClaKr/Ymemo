import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette } from "theme.slint";

// ---------------------------------------------------------------------------
// Sticky window: one frameless window per memo.
//  - Drag the title bar to move it (handled by Rust, with snapping on X11).
//  - Double-click the title bar to fold it to a thin bar.
//  - Palette, new memo, and close (which does not delete).
// ---------------------------------------------------------------------------
/// One photo on a sticky, filled in by Rust.
///
/// The core syncs the display size in em; Rust converts it against this window's body font,
/// so the values arriving here are already pixels.
export struct PhotoRow {
    id: string,
    image: image,
    width-px: length,
    height-px: length,
    // Not synced to this device yet, or undecodable.
    missing: bool,
}

export component StickyWindow inherits Window {
    title: root.memo-title == "" ? Strings.ui_sticky_window_title : root.memo-title;
    no-frame: true;
    always-on-top: true;
    background: #0000;
    preferred-width: 260px;
    preferred-height: 240px;
    min-width: 160px;
    min-height: 28px;
    resize-border-width: 4px;

    in property <string> memo-title;
    in-out property <string> memo-text;
    in property <string> sticky-color: "yellow";
    // Window opacity in percent; in-out because the slider previews it live.
    in-out property <float> sticky-opacity: 100;
    in property <bool> collapsed: false;
    in property <[PhotoRow]> photos: [];
    callback edited(string);
    // Attach a photo; Rust opens the file dialog.
    callback add-photo();
    callback show-history();
    // Resize a photo by a delta in em, which the core syncs to mobile too.
    callback resize-photo(string, float);
    callback close-requested();
    callback new-memo();
    callback set-color(string);
    callback set-opacity(float);
    callback toggle-collapse();
    // Title bar drag: we follow the pointer ourselves rather than leaving it to the OS, so
    // snapping happens during the drag and not only on release. All arguments are logical px
    // relative to the window's top-left corner.
    //   begin-drag takes the grab point; where window coordinates are unavailable (native
    //   Wayland) Rust falls back to the OS move and returns false, ending the tracking.
    callback begin-drag(float, float) -> bool;
    callback drag-move(float, float);   // current pointer position
    callback drag-end();

    // Creation time, already formatted by Rust; empty until it is set.
    in property <string> created-at;
    private property <bool> show-palette: false;
    // Whether this press became a drag, and whether we are tracking it ourselves.
    private property <bool> drag-started: false;
    private property <bool> drag-manual: false;

    public function focus-body() { body.focus(); }

    Rectangle {
        background: Palette.bg(root.sticky-color);
        // Square corners.
        border-radius: 0px;
        border-width: 1px;
        border-color: Palette.bar(root.sticky-color).darker(0.15);
        clip: true;
        // Fade the whole window, text included, so the desktop shows through.
        opacity: root.sticky-opacity / 100;

        VerticalLayout {
            // ---- Title bar: drag handle and fold toggle ----
            Rectangle {
                // Must match BAR_HEIGHT in sticky.rs, the folded window height.
                height: 28px;
                background: Palette.bar(root.sticky-color);

                bar-ta := TouchArea {
                    moved => {
                        // Over 4px counts as a drag, so clicks are not misread.
                        if (!root.drag-started
                            && (self.mouse-x > self.pressed-x + 4px || self.mouse-x < self.pressed-x - 4px
                                || self.mouse-y > self.pressed-y + 4px || self.mouse-y < self.pressed-y - 4px)) {
                            root.drag-started = true;
                            root.drag-manual = root.begin-drag(self.pressed-x / 1px, self.pressed-y / 1px);
                        }
                        if (root.drag-manual) {
                            root.drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            if (root.drag-manual) { root.drag-end(); }
                            root.drag-started = false;
                            root.drag-manual = false;
                        }
                    }
                    double-clicked => { root.toggle-collapse(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 2px;
                    Text {
                        text: root.memo-title == "" ? Strings.ui_sticky_default_title : root.memo-title;
                        font-size: 13px;
                        font-weight: 700;
                        color: Palette.ink(root.sticky-color);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    photo-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "📎";
                            font-size: 13px;
                            // Same reason as the colour chip below: without this the glyph
                            // falls back to the default text colour and disappears.
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: photo-ta.has-hover ? 1 : 0.7;
                        }
                        clicked => { root.add-photo(); }
                    }
                    history-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            // A glyph, not an emoji: emoji inherit the default text colour
                            // and vanish on these pastel bars.
                            text: "⟲";
                            font-size: 15px;
                            font-weight: 700;
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: history-ta.has-hover ? 1 : 0.6;
                        }
                        clicked => { root.show-history(); }
                    }
                    palette-ta := TouchArea {
                        width: 26px;
                        // A chip of the memo's own colour, not an emoji: an emoji that falls
                        // back to a monochrome glyph is drawn in the default text colour,
                        // which on these pastel bars is all but invisible. A filled circle
                        // with the title bar's ink around it reads at any colour, and says
                        // what it will change at the same time.
                        Rectangle {
                            width: 15px;
                            height: 15px;
                            border-radius: 8px;
                            background: Palette.swatch(root.sticky-color);
                            border-width: 1.5px;
                            border-color: Palette.ink(root.sticky-color);
                            opacity: palette-ta.has-hover ? 1 : 0.85;
                        }
                        clicked => { root.show-palette = !root.show-palette; }
                    }
                    plus-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "＋";
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: plus-ta.has-hover ? 1 : 0.55;
                        }
                        clicked => { root.new-memo(); }
                    }
                    close-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "✕";
                            font-size: 13px;
                            font-weight: 700;
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: close-ta.has-hover ? 1 : 0.55;
                        }
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // ---- Color and opacity panel. It stays open after a pick, since the two are
            // usually adjusted together. ----
            if root.show-palette: Rectangle {
                height: 72px;
                background: Palette.bar(root.sticky-color).darker(0.06);
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: Palette.swatch(key);
                            border-width: root.sticky-color == key ? 3px : 1px;
                            border-color: root.sticky-color == key ? #ffffff : #00000040;
                            chip := TouchArea {
                                clicked => { root.set-color(key); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: Strings.ui_sticky_opacity;
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 20; // matches the core's MIN_OPACITY
                            maximum: 100;
                            value: root.sticky-opacity;
                            // Preview while dragging, store once on release.
                            changed(v) => { root.sticky-opacity = v; }
                            released(v) => { root.set-opacity(v); }
                        }
                        Text {
                            text: Math.round(root.sticky-opacity) + "%";
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 34px;
                        }
                    }
                }
            }

            // ---- Body; invisible while folded, as the window is only the title bar tall ----
            body := TextEdit {
                visible: !root.collapsed;
                min-height: 0;
                vertical-stretch: 1;
                font-size: 13px;
                wrap: word-wrap;
                text <=> root.memo-text;
                edited => { root.edited(self.text); }
            }

            // ---- Photos. Stickies are small, so this takes space only when there are any;
            // the size chosen here is in em and reaches mobile through the core. ----
            if !root.collapsed && root.photos.length > 0: Flickable {
                max-height: 240px;
                viewport-height: photo-box.preferred-height;
                photo-box := VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    for photo in root.photos: VerticalLayout {
                        spacing: 2px;
                        if photo.missing: Text {
                            text: Strings.ui_sticky_photo_missing;
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            wrap: word-wrap;
                        }
                        if !photo.missing: Image {
                            source: photo.image;
                            width: photo.width-px;
                            height: photo.height-px;
                            image-fit: contain;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            minus-btn := Rectangle {
                                width: 22px;
                                height: 18px;
                                background: Palette.bar(root.sticky-color);
                                Text {
                                    text: "−";
                                    font-size: 12px;
                                    color: Palette.ink(root.sticky-color);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.resize-photo(photo.id, -4); } }
                            }
                            plus-btn := Rectangle {
                                width: 22px;
                                height: 18px;
                                background: Palette.bar(root.sticky-color);
                                Text {
                                    text: "＋";
                                    font-size: 12px;
                                    color: Palette.ink(root.sticky-color);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.resize-photo(photo.id, 4); } }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        // ---- Created-at, along the bottom edge. Declared last so it paints over the body
        // rather than under it, laid out by hand so it takes no line from the note, and
        // faint enough to read straight past. ----
        if !root.collapsed && root.created-at != "": Text {
            text: root.created-at;
            font-size: 9px;
            color: Palette.ink(root.sticky-color);
            opacity: 0.45;
            x: parent.width - self.width - 7px;
            y: parent.height - self.height - 4px;
        }
    }
}
