import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, TabButton } from "theme.slint";

// ---------------------------------------------------------------------------
// Settings window. Everything here is **device-local** and never synced; it maps one to one
// onto Settings in settings.rs. Values apply on save, and Rust writes back the clamped
// versions.
// ---------------------------------------------------------------------------
component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: #ece7db;
    }
    if root.hint != "": Text {
        text: root.hint;
        font-size: 10px;
        color: #a8a294;
        wrap: word-wrap;
    }
    @children
}

export component SettingsWindow inherits Window {
    title: Strings.ui_settings_window_title;
    preferred-width: 400px;
    preferred-height: 600px;
    min-width: 340px;
    background: #2e2b27;

    // Rust fills these in and reads them back on save.
    in-out property <string> lang-sel: "auto";
    in-out property <int> unlock-days: 30;
    in-out property <int> idle-minutes: 0;
    in-out property <string> default-color: "yellow";
    in-out property <int> default-opacity: 100;
    in-out property <int> merge-seconds: 15;
    // One-line status, e.g. the result of a save.
    in property <string> status;
    // Whether the vault is unlocked; locking again is meaningless when it is not.
    in property <bool> unlocked: false;
    // Running version (CARGO_PKG_VERSION), for bug reports.
    in property <string> app-version;

    callback apply();
    callback lock-now();
    callback close-requested();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: Strings.ui_settings_title;
            font-size: 16px;
            font-weight: 700;
            color: #f0ead6;
        }

        // ---- Language ----
        SettingRow {
            label: Strings.ui_settings_lang;
            hint: Strings.ui_settings_lang_hint;
            HorizontalLayout {
                TabButton {
                    label: Strings.ui_settings_lang_auto;
                    active: root.lang-sel == "auto";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "auto"; }
                }
                // Language names are **not** translated: written in their own language,
                // they are findable even by someone stuck in a language they cannot read.
                TabButton {
                    label: "한국어";
                    active: root.lang-sel == "ko";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "ko"; }
                }
                TabButton {
                    label: "English";
                    active: root.lang-sel == "en";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "en"; }
                }
            }
        }

        // ---- Locking ----
        SettingRow {
            label: Strings.ui_settings_unlock_days;
            hint: Strings.ui_settings_unlock_days_hint;
            SpinBox {
                minimum: 0;
                maximum: 365;
                value <=> root.unlock-days;
            }
        }

        SettingRow {
            label: Strings.ui_settings_idle_minutes;
            hint: Strings.ui_settings_idle_minutes_hint;
            SpinBox {
                minimum: 0;
                maximum: 1440;
                value <=> root.idle-minutes;
            }
        }

        // ---- New memo defaults ----
        SettingRow {
            label: Strings.ui_settings_default_color;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Palette.swatch(key);
                    border-width: root.default-color == key ? 3px : 1px;
                    border-color: root.default-color == key ? #ffffff : #00000040;
                    TouchArea {
                        clicked => { root.default-color = key; }
                    }
                }
            }
        }

        SettingRow {
            label: Strings.ui_settings_default_opacity;
            HorizontalLayout {
                spacing: 6px;
                Slider {
                    horizontal-stretch: 1;
                    minimum: 20; // matches the core's MIN_OPACITY
                    maximum: 100;
                    value: root.default-opacity;
                    changed(v) => { root.default-opacity = Math.round(v); }
                }
                Text {
                    text: root.default-opacity + "%";
                    font-size: 11px;
                    color: #ece7db;
                    vertical-alignment: center;
                    width: 40px;
                    horizontal-alignment: right;
                }
            }
        }

        // ---- Sync ----
        SettingRow {
            label: Strings.ui_settings_merge_seconds;
            hint: Strings.ui_settings_merge_seconds_hint;
            SpinBox {
                minimum: 3;
                maximum: 3600;
                value <=> root.merge-seconds;
            }
        }

        if root.status != "": Text {
            text: root.status;
            font-size: 11px;
            color: #a8d0a8;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: Strings.ui_settings_version + " " + root.app-version;
            font-size: 11px;
            color: #8a8375;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: Strings.ui_settings_lock_now;
                enabled: root.unlocked;
                clicked => { root.lock-now(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: Strings.ui_settings_close;
                clicked => { root.close-requested(); }
            }
            Button {
                text: Strings.ui_settings_save;
                primary: true;
                clicked => { root.apply(); }
            }
        }
    }
}
