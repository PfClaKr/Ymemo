import { Button, SpinBox, ScrollView, Palette as StdPalette } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, Scroll, TabButton, PrimaryButton, Toggle, ColorChip, InkSlider, Glyph } from "theme.slint";

// ---------------------------------------------------------------------------
// Settings window. Everything here is **device-local** and never synced; it maps one to one
// onto Settings in settings.rs.
//
// A side menu and one page at a time, rather than one long column of cards: every setting
// carried a hint cut to its first sentence with an ⓘ for the rest, and a window of those was
// a wall of half-sentences. Each page now holds a handful of settings with their whole
// explanation, written to be read in full.
//
// Changes apply as they are made (`edited`, debounced in Rust), as on the phone. The Save
// button, and the warning about leaving without pressing it, went with that.
// ---------------------------------------------------------------------------

// One entry of the side menu.
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    // A dot after the label: something on that page wants a look (a new version).
    in property <bool> badge: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.active ? #ffffff1a : ta.has-hover ? #ffffff0d : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    if root.active: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: #e2c22a;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 9px;
        Rectangle {
            width: 16px;
            Glyph {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                name: root.icon;
                stroke: root.active ? #e2c22a : #a8a294;
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.active ? 700 : 400;
            color: root.active ? #f0ead6 : #c8c2b2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.badge: Rectangle {
            width: 7px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: #e2c22a;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page's heading, and the sentence that says what the page is about when one is needed.
component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> intro;
    spacing: 4px;
    Text {
        text: root.title;
        font-size: 17px;
        font-weight: 700;
        color: #f0ead6;
    }
    if root.intro != "": Text {
        text: root.intro;
        font-size: 11px;
        color: #a8a294;
        wrap: word-wrap;
    }
}

// A few settings on one rounded panel, a shade lighter than the window, divided by hairlines.
component Group inherits Rectangle {
    background: #36322d;
    border-radius: 10px;
    // Never taller than its rows, on a page shorter than the window.
    vertical-stretch: 0;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

// The small heading over a group, where a page has more than one kind of thing on it.
component GroupTitle inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: #d8c765;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #ffffff12;
}

// A setting whose control is small (a switch, a number, a button): its name and what it does
// on the left, the control at the right end of the same row.
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    padding-top: 11px;
    padding-bottom: 11px;
    spacing: 18px;
    vertical-stretch: 0;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 700;
            color: #ece7db;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 11px;
            color: #a8a294;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        horizontal-stretch: 0;
        alignment: center;
        @children
    }
}

// A setting whose control wants the row's width (a slider): the control under its name.
component BlockRow inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    padding-top: 11px;
    padding-bottom: 12px;
    spacing: 8px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 700;
            color: #ece7db;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 11px;
            color: #a8a294;
            wrap: word-wrap;
        }
    }
    @children
}

// A number and its unit ("30 일"), the unit beside the field rather than in the label.
component NumberField inherits HorizontalLayout {
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <string> unit;
    spacing: 6px;
    // The std SpinBox in a box of its own size. Laid out directly in a row, it handed the row
    // a preferred height several times its own — on a page shorter than the window, each row
    // holding one came out a third of the window tall (measured; a plain box in its place
    // laid out normally).
    Rectangle {
        width: 96px;
        height: 32px;
        SpinBox {
            width: 100%;
            height: 100%;
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
        }
    }
    Text {
        text: root.unit;
        font-size: 11px;
        color: #a8a294;
        vertical-alignment: center;
        // One width for every unit, so the fields stand in one column whether the unit is
        // "days", "min" or "초".
        width: 30px;
    }
}

// A percentage slider with its value beside it.
component PercentSlider inherits HorizontalLayout {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <string> label;
    in-out property <int> value;
    spacing: 10px;
    InkSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value: root.value;
        label: root.label;
        track: #ffffff24;
        changed(v) => { root.value = Math.round(v); }
    }
    Text {
        text: root.value + "%";
        font-size: 11px;
        color: #ece7db;
        vertical-alignment: center;
        horizontal-alignment: right;
        width: 40px;
    }
}

// A key, or a chord written as one ("Ctrl+W"), drawn as a key cap. An arrow key is drawn
// (`icon`), not typed: ↑ is in no font the app can count on.
component KeyCap inherits Rectangle {
    in property <string> keys;
    in property <string> icon;
    height: 22px;
    min-width: root.icon != "" ? 24px : max(26px, label.preferred-width + 14px);
    horizontal-stretch: 0;
    border-radius: 4px;
    background: #ffffff0d;
    border-width: 1px;
    border-color: #ffffff26;
    label := Text {
        width: 100%;
        height: 100%;
        text: root.keys;
        font-size: 11px;
        color: #e8e2d2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "": Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        name: root.icon;
        stroke: #e8e2d2;
    }
}

// What a key does, and the key — after the two arrow keys, when `arrows` is set.
component Shortcut inherits HorizontalLayout {
    in property <string> keys;
    in property <string> action;
    in property <bool> arrows: false;
    padding-top: 8px;
    padding-bottom: 8px;
    spacing: 12px;
    Text {
        text: root.action;
        font-size: 12px;
        color: #ece7db;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 4px;
            if root.arrows: KeyCap { icon: "arrow-up"; }
            if root.arrows: KeyCap { icon: "arrow-down"; }
            KeyCap { keys: root.keys; }
        }
    }
}

export component SettingsWindow inherits Window {
    default-font-family: "Pretendard";
    // This window is always dark, so the standard controls in it are too. Left to follow the
    // system they came out light on a light-mode desktop — pale grey boxes set into a dark
    // window, and a disabled primary button drawn darker than an enabled one beside it.
    init => { StdPalette.color-scheme = ColorScheme.dark; }
    title: Strings.ui_settings_window_title;
    // Keep in step with the size `settings_window.rs` opens it at: a Window whose root is a
    // layout opens at the layout's minimum otherwise.
    preferred-width: 680px;
    preferred-height: 500px;
    min-width: 600px;
    min-height: 440px;
    background: #2e2b27;

    // Rust fills these in and reads them back as they change.
    in-out property <string> lang-sel: "auto";
    in-out property <int> unlock-days: 30;
    in-out property <int> idle-minutes: 0;
    in-out property <string> default-color: "yellow";
    in-out property <int> default-opacity: 100;
    in-out property <int> note-text-percent: 100;
    in-out property <int> merge-seconds: 15;
    in-out property <int> watch-delay-seconds: 10;
    in-out property <int> rescan-seconds: 60;
    in-out property <int> keep-versions-days: 30;
    // Starting with the session. Read from the desktop itself rather than from settings.json
    // — see `autostart.rs` — so this is filled in every time the window opens.
    in-out property <bool> start-at-login: false;
    // Whether this build has anywhere to write that; the row is hidden where it has not.
    in property <bool> autostart-supported: false;
    // Whether to ask GitHub about new releases. The only outbound request the app makes, so
    // it is a setting rather than a given.
    in-out property <bool> update-check: true;
    // One line about something that happened: an export, a failure, the session dropped by a
    // change of the stay-unlocked period. Cleared when another page is opened.
    in-out property <string> status;
    // Whether the vault is unlocked; locking, exporting and the security window need it.
    in property <bool> unlocked: false;
    // Running version (CARGO_PKG_VERSION), for bug reports.
    in property <string> app-version;
    // Version of a newer release, empty when there is none (or none known yet).
    in property <string> update-version;
    // File name of the package for this machine, empty when the release carries none for it
    // and the button falls back to the release page.
    in property <string> update-file;
    // One line about the last check: in progress, up to date, or why it failed.
    in property <string> update-status;
    // Which page is open: general, notes, lock, sync, data, shortcuts, about.
    in-out property <int> page: 0;
    private property <int> page-count: 7;

    // Any setting moved; Rust stores and applies it a moment later.
    callback edited();
    callback lock-now();
    callback close-requested();
    // Opens the security window: the master password and the recovery code live there.
    callback open-security();
    callback check-update();
    callback open-update();
    callback open-log();
    // Every memo written out as Markdown files in a zip; see ymemo_core::export.
    callback export-memos();
    callback open-project();

    changed lang-sel => { root.edited(); }
    changed unlock-days => { root.edited(); }
    changed idle-minutes => { root.edited(); }
    changed default-color => { root.edited(); }
    changed default-opacity => { root.edited(); }
    changed note-text-percent => { root.edited(); }
    changed merge-seconds => { root.edited(); }
    changed watch-delay-seconds => { root.edited(); }
    changed rescan-seconds => { root.edited(); }
    changed keep-versions-days => { root.edited(); }
    changed start-at-login => { root.edited(); }
    changed update-check => { root.edited(); }
    // A new page starts at its top, and a message about the last one is not about this one.
    changed page => {
        scroll.viewport-y = 0px;
        root.status = "";
    }

    function go(p: int) {
        root.page = Math.mod(p + root.page-count, root.page-count);
        keys.focus();
    }

    // Escape closes the window, as it closes every other dialog here; Ctrl+Tab steps through
    // the pages. A `FocusScope` around the whole of it, because Slint sends a key to the
    // focused item first and then up through its ancestors.
    keys := FocusScope {
        // Nothing has the focus in a window that has just opened, so it takes it; anything
        // clicked into takes it away and gets its keys first.
        init => { self.focus(); }
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (ev.modifiers.control && ev.text == Key.Tab) {
                root.go(root.page + 1);
                return accept;
            }
            if (ev.modifiers.control && ev.text == Key.Backtab) {
                root.go(root.page - 1);
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            // ---- The side menu ----
            Rectangle {
                width: 176px;
                background: #282521;
                VerticalLayout {
                    padding: 10px;
                    padding-top: 16px;
                    spacing: 2px;
                    Text {
                        text: Strings.ui_settings_title;
                        font-size: 15px;
                        font-weight: 700;
                        color: #f0ead6;
                    }
                    Rectangle { height: 12px; }
                    NavItem {
                        icon: "gear";
                        label: Strings.ui_settings_nav_general;
                        active: root.page == 0;
                        clicked => { root.go(0); }
                    }
                    NavItem {
                        icon: "note";
                        label: Strings.ui_settings_nav_notes;
                        active: root.page == 1;
                        clicked => { root.go(1); }
                    }
                    NavItem {
                        icon: "lock";
                        label: Strings.ui_settings_nav_lock;
                        active: root.page == 2;
                        clicked => { root.go(2); }
                    }
                    NavItem {
                        icon: "link";
                        label: Strings.ui_settings_nav_sync;
                        active: root.page == 3;
                        clicked => { root.go(3); }
                    }
                    NavItem {
                        icon: "data";
                        label: Strings.ui_settings_nav_data;
                        active: root.page == 4;
                        clicked => { root.go(4); }
                    }
                    NavItem {
                        icon: "keyboard";
                        label: Strings.ui_settings_nav_shortcuts;
                        active: root.page == 5;
                        clicked => { root.go(5); }
                    }
                    NavItem {
                        icon: "info";
                        label: Strings.ui_settings_nav_about;
                        active: root.page == 6;
                        badge: root.update-version != "";
                        clicked => { root.go(6); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    // There is no Save button, so say where it went.
                    Text {
                        text: Strings.ui_settings_auto_saved;
                        font-size: 10px;
                        color: #8a8375;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Strings.ui_settings_version + " " + root.app-version;
                        font-size: 10px;
                        color: #8a8375;
                    }
                }
            }

            // ---- The page ----
            VerticalLayout {
                horizontal-stretch: 1;
                // The content is given the view's width less the scrollbar's, so nothing in
                // it runs under the bar and the wrapping descriptions have a width to wrap at.
                scroll := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: content.preferred-height;

                    content := VerticalLayout {
                        width: scroll.visible-width - Scroll.gutter;
                        padding-left: 20px;
                        padding-right: 8px;
                        padding-top: 18px;
                        // Slack under the last row: wrapped paragraphs can measure themselves
                        // shorter than they draw (see the pairing panel).
                        padding-bottom: 32px;
                        spacing: 12px;
                        alignment: start;

                        // ---- General ----
                        if root.page == 0: VerticalLayout {
                            spacing: 12px;
                            PageTitle { title: Strings.ui_settings_nav_general; }
                            Group {
                                Row {
                                    label: Strings.ui_settings_lang;
                                    description: Strings.ui_settings_lang_hint;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        TabButton {
                                            label: Strings.ui_settings_lang_auto;
                                            active: root.lang-sel == "auto";
                                            ink: #d8d2c2;
                                            clicked => { root.lang-sel = "auto"; }
                                        }
                                        // Language names are **not** translated: written in their
                                        // own language, they are findable even by someone stuck in
                                        // a language they cannot read.
                                        TabButton {
                                            label: "한국어";
                                            active: root.lang-sel == "ko";
                                            ink: #d8d2c2;
                                            clicked => { root.lang-sel = "ko"; }
                                        }
                                        TabButton {
                                            label: "English";
                                            active: root.lang-sel == "en";
                                            ink: #d8d2c2;
                                            clicked => { root.lang-sel = "en"; }
                                        }
                                    }
                                }
                                if root.autostart-supported: Divider { }
                                if root.autostart-supported: Row {
                                    label: Strings.ui_settings_start_at_login;
                                    description: Strings.ui_settings_start_at_login_hint;
                                    Toggle {
                                        label: Strings.ui_settings_start_at_login;
                                        checked <=> root.start-at-login;
                                    }
                                }
                            }
                        }

                        // ---- Notes: what a new one looks like, and how large every one reads ----
                        if root.page == 1: VerticalLayout {
                            spacing: 12px;
                            PageTitle { title: Strings.ui_settings_nav_notes; }
                            // The three settings below, on a note, as they change. Drawn on the
                            // window's own dark, which is roughly what a faded note shows over.
                            Group {
                                VerticalLayout {
                                    padding-top: 12px;
                                    padding-bottom: 14px;
                                    spacing: 8px;
                                    GroupTitle { text: Strings.ui_settings_preview; }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 220px;
                                            height: 112px;
                                            background: Palette.bg(root.default-color);
                                            border-width: 1px;
                                            border-color: Palette.edge(root.default-color);
                                            opacity: root.default-opacity / 100;
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: 24px;
                                                background: Palette.bar(root.default-color);
                                                Text {
                                                    x: 8px;
                                                    height: 100%;
                                                    text: Strings.ui_sticky_default_title;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Palette.ink(root.default-color);
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                x: 8px;
                                                y: 29px;
                                                width: parent.width - 16px;
                                                text: Strings.ui_settings_preview_text;
                                                // 13px is the note's body size (BODY_FONT_PX).
                                                font-size: 13px * root.note-text-percent / 100;
                                                color: #2b2b22;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            Group {
                                Row {
                                    label: Strings.ui_settings_default_color;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for key in ["yellow", "pink", "green", "blue", "purple"]: ColorChip {
                                            size: 22px;
                                            key: key;
                                            selected: root.default-color == key;
                                            picked => { root.default-color = key; }
                                        }
                                    }
                                }
                                Divider { }
                                BlockRow {
                                    label: Strings.ui_settings_default_opacity;
                                    PercentSlider {
                                        minimum: 20; // matches the core's MIN_OPACITY
                                        maximum: 100;
                                        step: 1;
                                        label: Strings.ui_settings_default_opacity;
                                        value <=> root.default-opacity;
                                    }
                                }
                                Divider { }
                                BlockRow {
                                    label: Strings.ui_settings_note_text;
                                    description: Strings.ui_settings_note_text_hint;
                                    PercentSlider {
                                        // NOTE_TEXT_PERCENT in settings.rs; never below 100, see there.
                                        minimum: 100;
                                        maximum: 200;
                                        step: 10;
                                        label: Strings.ui_settings_note_text;
                                        value <=> root.note-text-percent;
                                    }
                                }
                            }
                        }

                        // ---- Lock and security ----
                        if root.page == 2: VerticalLayout {
                            spacing: 12px;
                            PageTitle { title: Strings.ui_settings_nav_lock; }
                            Group {
                                Row {
                                    label: Strings.ui_settings_unlock_days;
                                    description: Strings.ui_settings_unlock_days_hint;
                                    NumberField {
                                        minimum: 0;
                                        maximum: 365;
                                        value <=> root.unlock-days;
                                        unit: Strings.ui_settings_unit_days;
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_idle_minutes;
                                    description: Strings.ui_settings_idle_minutes_hint;
                                    NumberField {
                                        minimum: 0;
                                        maximum: 1440;
                                        value <=> root.idle-minutes;
                                        unit: Strings.ui_settings_unit_minutes;
                                    }
                                }
                            }
                            // What used to be two buttons under every page of settings, here
                            // where they belong: neither is a setting, both are about the lock.
                            Group {
                                Row {
                                    label: Strings.ui_settings_security;
                                    description: Strings.ui_settings_security_hint;
                                    Button {
                                        text: Strings.ui_settings_security_open;
                                        enabled: root.unlocked;
                                        clicked => { root.open-security(); }
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_lock_now;
                                    description: Strings.ui_settings_lock_now_hint;
                                    Button {
                                        text: Strings.ui_settings_lock_now_button;
                                        enabled: root.unlocked;
                                        clicked => { root.lock-now(); }
                                    }
                                }
                            }
                        }

                        // ---- Sync timing. Together because that is how they behave: the delay
                        // a user sees is the sending device's wait plus the receiving one's
                        // interval, and tuning either alone disappoints. ----
                        if root.page == 3: VerticalLayout {
                            spacing: 12px;
                            PageTitle {
                                title: Strings.ui_settings_nav_sync;
                                intro: Strings.ui_settings_sync_intro;
                            }
                            Group {
                                Row {
                                    label: Strings.ui_settings_watch_delay;
                                    description: Strings.ui_settings_watch_delay_hint;
                                    NumberField {
                                        minimum: 1;
                                        maximum: 60;
                                        value <=> root.watch-delay-seconds;
                                        unit: Strings.ui_settings_unit_seconds;
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_merge_seconds;
                                    description: Strings.ui_settings_merge_seconds_hint;
                                    NumberField {
                                        minimum: 3;
                                        maximum: 3600;
                                        value <=> root.merge-seconds;
                                        unit: Strings.ui_settings_unit_seconds;
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_rescan;
                                    description: Strings.ui_settings_rescan_hint;
                                    NumberField {
                                        minimum: 60;
                                        maximum: 3600;
                                        value <=> root.rescan-seconds;
                                        unit: Strings.ui_settings_unit_seconds;
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_keep_versions;
                                    description: Strings.ui_settings_keep_versions_hint;
                                    NumberField {
                                        minimum: 0;
                                        maximum: 365;
                                        value <=> root.keep-versions-days;
                                        unit: Strings.ui_settings_unit_days;
                                    }
                                }
                            }
                        }

                        // ---- Data: the way out, and the file someone is sent to ----
                        if root.page == 4: VerticalLayout {
                            spacing: 12px;
                            PageTitle { title: Strings.ui_settings_nav_data; }
                            Group {
                                // Only while unlocked — there is nothing readable to write out
                                // otherwise.
                                Row {
                                    label: Strings.ui_settings_export;
                                    description: Strings.ui_settings_export_hint;
                                    Button {
                                        text: Strings.ui_settings_export_button;
                                        enabled: root.unlocked;
                                        clicked => { root.export-memos(); }
                                    }
                                }
                                Divider { }
                                Row {
                                    label: Strings.ui_settings_log;
                                    description: Strings.ui_settings_log_hint;
                                    Button {
                                        text: Strings.ui_settings_log_open;
                                        clicked => { root.open-log(); }
                                    }
                                }
                            }
                        }

                        // ---- Shortcuts. Read-only: the keys were only ever named in a few
                        // button labels, and most of them nowhere at all. ----
                        if root.page == 5: VerticalLayout {
                            spacing: 8px;
                            PageTitle { title: Strings.ui_settings_nav_shortcuts; }
                            Rectangle { height: 4px; }
                            GroupTitle { text: Strings.ui_shortcuts_notes; }
                            Group {
                                Shortcut { keys: "Ctrl+N"; action: Strings.ui_shortcut_new; }
                                Divider { }
                                Shortcut { keys: "Ctrl+W"; action: Strings.ui_shortcut_close; }
                                Divider { }
                                Shortcut { keys: "Esc"; action: Strings.ui_shortcut_done; }
                                Divider { }
                                Shortcut { keys: "Ctrl+=  Ctrl+-"; action: Strings.ui_shortcut_zoom; }
                                Divider { }
                                Shortcut { keys: "Ctrl+0"; action: Strings.ui_shortcut_zoom_reset; }
                                Divider { }
                                Shortcut { keys: Strings.ui_shortcut_fold_key; action: Strings.ui_shortcut_fold; }
                            }
                            Rectangle { height: 6px; }
                            GroupTitle { text: Strings.ui_shortcuts_list; }
                            Group {
                                Shortcut { arrows: true; keys: "Home  End"; action: Strings.ui_shortcut_move; }
                                Divider { }
                                Shortcut { keys: "Enter"; action: Strings.ui_shortcut_open; }
                                Divider { }
                                Shortcut { keys: "F2"; action: Strings.ui_shortcut_rename; }
                                Divider { }
                                Shortcut { keys: "Delete"; action: Strings.ui_shortcut_delete; }
                                Divider { }
                                Shortcut { keys: "Ctrl+Z"; action: Strings.ui_shortcut_undo; }
                                Divider { }
                                Shortcut { keys: "Esc"; action: Strings.ui_shortcut_deselect; }
                            }
                            Rectangle { height: 6px; }
                            GroupTitle { text: Strings.ui_shortcuts_dialogs; }
                            Group {
                                Shortcut { keys: "Esc"; action: Strings.ui_shortcut_close_window; }
                                Divider { }
                                Shortcut { arrows: true; keys: "Enter"; action: Strings.ui_shortcut_pick_version; }
                                Divider { }
                                Shortcut { keys: "Ctrl+Tab"; action: Strings.ui_shortcut_next_page; }
                            }
                        }

                        // ---- About: the version, whether there is a newer one, and where the
                        // project lives ----
                        if root.page == 6: VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;
                                Image {
                                    source: @image-url("../../../packaging/assets/ymemo-64.png");
                                    width: 52px;
                                    height: 52px;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: "Ymemo";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #f0ead6;
                                    }
                                    Text {
                                        text: Strings.ui_settings_tagline;
                                        font-size: 11px;
                                        color: #a8a294;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            Group {
                                Row {
                                    label: Strings.ui_settings_update_check;
                                    description: Strings.ui_settings_update_check_hint;
                                    Toggle {
                                        label: Strings.ui_settings_update_check;
                                        checked <=> root.update-check;
                                    }
                                }
                                Divider { }
                                // The version, and what the last check said about it.
                                Row {
                                    label: Strings.ui_settings_version + " " + root.app-version;
                                    description: root.update-version != "" ? "" : root.update-status;
                                    Button {
                                        text: Strings.ui_settings_check_now;
                                        clicked => { root.check-update(); }
                                    }
                                }
                                // A newer one, and the file the button fetches. Naming it is the
                                // whole point of picking one: the release page lists seven.
                                if root.update-version != "": Divider { }
                                if root.update-version != "": Row {
                                    label: Strings.ui_update_available + " " + root.update-version;
                                    description: root.update-file;
                                    PrimaryButton {
                                        text: Strings.ui_update_open;
                                        clicked => { root.open-update(); }
                                    }
                                }
                            }
                            Group {
                                Row {
                                    label: Strings.ui_settings_project;
                                    description: "github.com/PfClaKr/Ymemo";
                                    Button {
                                        text: Strings.ui_list_menu_open;
                                        clicked => { root.open-project(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // What just happened, under the page it happened on.
                if root.status != "": Rectangle {
                    height: 30px;
                    background: #36322d;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 12px;
                        Text {
                            text: root.status;
                            font-size: 11px;
                            color: #e8d98a;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
