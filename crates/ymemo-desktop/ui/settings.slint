import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox, ScrollView, Palette as StdPalette } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, Scroll, TabButton, PrimaryButton, Toggle } from "theme.slint";

// ---------------------------------------------------------------------------
// Settings window. Everything here is **device-local** and never synced; it maps one to one
// onto Settings in settings.rs. Values apply on save, and Rust writes back the clamped
// versions.
// ---------------------------------------------------------------------------
// A setting's name, its ⓘ, and the hint under it.
component RowText inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    // The hint's first sentence (`*_hint_short`, generated by build.rs): what shows until the
    // ⓘ beside the label opens the whole of it. Several hints ran four lines, and a window of
    // them was a wall of text around the few controls it was for.
    in property <string> hint-short;
    private property <bool> more: root.hint-short != "" && root.hint-short != root.hint;
    private property <bool> open: false;
    spacing: 2px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 700;
            color: #ece7db;
            vertical-alignment: center;
        }
        if root.more: Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            border-width: 1px;
            border-color: info-ta.has-hover || root.open ? #ece7db : #8d8778;
            Text {
                text: "i";
                font-size: 9px;
                font-weight: 700;
                color: parent.border-color;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            info-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }
        }
    }
    if root.hint != "": Text {
        text: root.more && !root.open ? root.hint-short : root.hint;
        font-size: 10px;
        color: #a8a294;
        wrap: word-wrap;
    }
}

// A setting whose control needs the row's width (a slider, a row of choices): the control
// goes under the name.
component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> hint-short;
    spacing: 4px;
    RowText {
        label: root.label;
        hint: root.hint;
        hint-short: root.hint-short;
    }
    @children
}

// A setting whose control is small (a switch, a number): the name and hint on the left, the
// control at the right end of the same row, the way settings screens usually lay it out. A
// two-digit number used to sit in a field the whole width of the window.
component InlineRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> hint-short;
    spacing: 12px;
    RowText {
        horizontal-stretch: 1;
        label: root.label;
        hint: root.hint;
        hint-short: root.hint-short;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// A number and its unit ("30 일"), the unit beside the field rather than in the label, where
// only some of the labels had one.
component NumberField inherits HorizontalLayout {
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <string> unit;
    spacing: 6px;
    SpinBox {
        width: 96px;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
    }
    Text {
        text: root.unit;
        font-size: 11px;
        color: #a8a294;
        vertical-alignment: center;
        min-width: 22px;
    }
}

// One group of settings: a rounded panel a shade lighter than the window, headed by what the
// group is about. The window used to be one long column of rows, which read as a form to fill
// in rather than as a few things to look at.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    // As in SettingRow: the first sentence, the rest behind the ⓘ.
    in property <string> hint-short;
    private property <bool> more: root.hint-short != "" && root.hint-short != root.hint;
    private property <bool> open: false;
    background: #36322d;
    border-radius: 10px;
    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.title;
                    font-size: 11px;
                    font-weight: 700;
                    color: #d8c765;
                    vertical-alignment: center;
                }
                if root.more: Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: card-info.has-hover || root.open ? #d8c765 : #8d8778;
                    Text {
                        text: "i";
                        font-size: 9px;
                        font-weight: 700;
                        color: parent.border-color;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    card-info := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open = !root.open; }
                    }
                }
            }
            if root.hint != "": Text {
                text: root.more && !root.open ? root.hint-short : root.hint;
                font-size: 10px;
                color: #a8a294;
                wrap: word-wrap;
            }
        }
        @children
    }
}

export component SettingsWindow inherits Window {
    default-font-family: "Pretendard";
    // This window is always dark, so the standard controls in it are too. Left to follow the
    // system they came out light on a light-mode desktop — pale grey boxes set into a dark
    // window, and a disabled primary button drawn darker than an enabled one beside it.
    init => { StdPalette.color-scheme = ColorScheme.dark; }
    title: Strings.ui_settings_window_title;
    preferred-width: 420px;
    preferred-height: 600px;
    // The window opens at its layout's width, and that settled on the minimum: at 340px
    // every hint wrapped each few words into a column. 400 is where they read as sentences.
    min-width: 400px;
    // A Window whose root is a layout is sized by that layout, not by `preferred-height`,
    // so this is what the window actually opens at. Everything above the buttons scrolls,
    // so it is a comfortable height rather than a required one.
    min-height: 520px;
    background: #2e2b27;

    // Rust fills these in and reads them back on save.
    in-out property <string> lang-sel: "auto";
    in-out property <int> unlock-days: 30;
    in-out property <int> idle-minutes: 0;
    in-out property <string> default-color: "yellow";
    in-out property <int> default-opacity: 100;
    in-out property <int> note-text-percent: 100;
    in-out property <int> merge-seconds: 15;
    in-out property <int> watch-delay-seconds: 10;
    in-out property <int> rescan-seconds: 60;
    in-out property <int> keep-versions-days: 30;
    // One-line status, e.g. the result of a save.
    in property <string> status;
    // A close was refused once over unsaved changes; the next one goes through. Rust sets it.
    in-out property <bool> close-warned: false;
    // Whether the vault is unlocked; locking again is meaningless when it is not.
    in property <bool> unlocked: false;
    // Running version (CARGO_PKG_VERSION), for bug reports.
    in property <string> app-version;
    // Whether to ask GitHub about new releases. The only outbound request the app makes, so
    // it is a setting rather than a given.
    in-out property <bool> update-check: true;
    // Starting with the session. Read from the desktop itself rather than from settings.json
    // — see `autostart.rs` — so this is filled in every time the window opens.
    in-out property <bool> start-at-login: false;
    // Whether this build has anywhere to write that; the row is hidden where it has not.
    in property <bool> autostart-supported: false;
    // Version of a newer release, empty when there is none (or none known yet).
    in property <string> update-version;
    // File name of the package for this machine, empty when the release carries none for it
    // and the button falls back to the release page.
    in property <string> update-file;
    // One line about the last check: in progress, up to date, or why it failed.
    in property <string> update-status;

    callback apply();
    callback lock-now();
    callback close-requested();
    // Opens the security window; the master password and recovery code live there, since
    // they are the only things on this screen that are not device-local settings.
    callback open-security();
    callback check-update();
    callback open-log();
    // Every memo written out as Markdown files in a zip; see ymemo_core::export.
    callback export-memos();
    callback open-update();

    // Escape closes this window, the way it closes the folder-name box and puts a
    // note down. A `FocusScope` around the whole of it rather than a handler on one
    // control: Slint sends a key to the focused item first and then up through its
    // ancestors, so this is reached whatever the user last clicked into.
    keys := FocusScope {
        // Nothing has the focus in a window that has just opened, so it takes it;
        // anything clicked into takes it away and gets its keys first.
        init => { self.focus(); }
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: Strings.ui_settings_title;
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
            }

            // Everything between the title and the buttons scrolls.
            //
            // Two things forced this. The settings are already taller than a laptop screen, and
            // the buttons — Save among them — were the first thing to go off the bottom. And the
            // wrapping hint under each label has no width to wrap against while the window is
            // deciding how big to be, so each one measured itself one character per line: the
            // window opened **3301px tall**, with everything from the colour swatches down past
            // the bottom of the screen. Giving the content an explicit width (`visible-width`)
            // is what lets those hints measure themselves properly.
            scroll := ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: content.preferred-height;

                content := VerticalLayout {
                    width: scroll.visible-width - Scroll.gutter;
                    spacing: 12px;
                    // ---- General ----
                    Card {
                        title: Strings.ui_settings_section_general;
                        hint: "";
                        // ---- Language ----
                        SettingRow {
                            label: Strings.ui_settings_lang;
                            hint: Strings.ui_settings_lang_hint;
                            hint-short: Strings.ui_settings_lang_hint_short;
                            HorizontalLayout {
                                TabButton {
                                    label: Strings.ui_settings_lang_auto;
                                    active: root.lang-sel == "auto";
                                    ink: #d8d2c2;
                                    clicked => { root.lang-sel = "auto"; }
                                }
                                // Language names are **not** translated: written in their own language,
                                // they are findable even by someone stuck in a language they cannot read.
                                TabButton {
                                    label: "한국어";
                                    active: root.lang-sel == "ko";
                                    ink: #d8d2c2;
                                    clicked => { root.lang-sel = "ko"; }
                                }
                                TabButton {
                                    label: "English";
                                    active: root.lang-sel == "en";
                                    ink: #d8d2c2;
                                    clicked => { root.lang-sel = "en"; }
                                }
                            }
                        }

                        // ---- Start at login ----
                        if root.autostart-supported: InlineRow {
                            label: Strings.ui_settings_start_at_login;
                            hint: Strings.ui_settings_start_at_login_hint;
                            hint-short: Strings.ui_settings_start_at_login_hint_short;
                            Toggle {
                                label: Strings.ui_settings_start_at_login;
                                checked <=> root.start-at-login;
                            }
                        }

                        // ---- Updates ----
                        InlineRow {
                            label: Strings.ui_settings_update_check;
                            hint: Strings.ui_settings_update_check_hint;
                            hint-short: Strings.ui_settings_update_check_hint_short;
                            Toggle {
                                label: Strings.ui_settings_update_check;
                                checked <=> root.update-check;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: Strings.ui_settings_check_now;
                                clicked => { root.check-update(); }
                            }
                        }

                        if root.update-status != "": Text {
                            text: root.update-status;
                            font-size: 11px;
                            color: root.update-version != "" ? #e8d98a : #a8a294;
                            wrap: word-wrap;
                        }

                        // The file the button is about to fetch. Naming it is the whole point of
                        // picking one: the release page lists seven and this says which is yours.
                        if root.update-file != "": Text {
                            text: root.update-file;
                            font-size: 10px;
                            font-family: "monospace";
                            color: #a8a294;
                            wrap: word-wrap;
                        }

                        if root.update-version != "": HorizontalLayout {
                            alignment: start;
                            PrimaryButton {
                                text: Strings.ui_update_open;
                                clicked => { root.open-update(); }
                            }
                        }
                    }

                    // ---- Locking ----
                    Card {
                        title: Strings.ui_settings_section_lock;
                        hint: "";
                        // ---- Locking ----
                        InlineRow {
                            label: Strings.ui_settings_unlock_days;
                            hint: Strings.ui_settings_unlock_days_hint;
                            hint-short: Strings.ui_settings_unlock_days_hint_short;
                            NumberField {
                                minimum: 0;
                                maximum: 365;
                                value <=> root.unlock-days;
                                unit: Strings.ui_settings_unit_days;
                            }
                        }

                        InlineRow {
                            label: Strings.ui_settings_idle_minutes;
                            hint: Strings.ui_settings_idle_minutes_hint;
                            hint-short: Strings.ui_settings_idle_minutes_hint_short;
                            NumberField {
                                minimum: 0;
                                maximum: 1440;
                                value <=> root.idle-minutes;
                                unit: Strings.ui_settings_unit_minutes;
                            }
                        }
                    }

                    // ---- New memos and how they read ----
                    Card {
                        title: Strings.ui_settings_section_new_memo;
                        hint: "";
                        // ---- New memo defaults ----
                        SettingRow {
                            label: Strings.ui_settings_default_color;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Palette.swatch(key);
                                    border-width: root.default-color == key ? 3px : 1px;
                                    border-color: root.default-color == key ? #ffffff : #00000040;
                                    TouchArea {
                                        clicked => { root.default-color = key; }
                                    }
                                }
                            }
                        }

                        SettingRow {
                            label: Strings.ui_settings_default_opacity;
                            HorizontalLayout {
                                spacing: 6px;
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: 20; // matches the core's MIN_OPACITY
                                    maximum: 100;
                                    value: root.default-opacity;
                                    changed(v) => { root.default-opacity = Math.round(v); }
                                }
                                Text {
                                    text: root.default-opacity + "%";
                                    font-size: 11px;
                                    color: #ece7db;
                                    vertical-alignment: center;
                                    width: 40px;
                                    horizontal-alignment: right;
                                }
                            }
                        }

                        SettingRow {
                            label: Strings.ui_settings_note_text;
                            hint: Strings.ui_settings_note_text_hint;
                            hint-short: Strings.ui_settings_note_text_hint_short;
                            HorizontalLayout {
                                spacing: 6px;
                                Slider {
                                    horizontal-stretch: 1;
                                    // NOTE_TEXT_PERCENT in settings.rs; never below 100, see there.
                                    minimum: 100;
                                    maximum: 200;
                                    step: 10;
                                    value: root.note-text-percent;
                                    changed(v) => { root.note-text-percent = Math.round(v / 10) * 10; }
                                }
                                Text {
                                    text: root.note-text-percent + "%";
                                    font-size: 11px;
                                    color: #ece7db;
                                    vertical-alignment: center;
                                    width: 40px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    // ---- Sync timing. The three timings live together because that is how they behave: the delay
                    // a user sees is the sending device's watch delay plus the receiving one's
                    // merge interval, and tuning either alone disappoints ----
                    Card {
                        title: Strings.ui_settings_advanced;
                        hint: Strings.ui_settings_advanced_hint;
                        hint-short: Strings.ui_settings_advanced_hint_short;
                        InlineRow {
                            label: Strings.ui_settings_watch_delay;
                            hint: Strings.ui_settings_watch_delay_hint;
                            hint-short: Strings.ui_settings_watch_delay_hint_short;
                            NumberField {
                                minimum: 1;
                                maximum: 60;
                                value <=> root.watch-delay-seconds;
                                unit: Strings.ui_settings_unit_seconds;
                            }
                        }

                        InlineRow {
                            label: Strings.ui_settings_merge_seconds;
                            hint: Strings.ui_settings_merge_seconds_hint;
                            hint-short: Strings.ui_settings_merge_seconds_hint_short;
                            NumberField {
                                minimum: 3;
                                maximum: 3600;
                                value <=> root.merge-seconds;
                                unit: Strings.ui_settings_unit_seconds;
                            }
                        }

                        InlineRow {
                            label: Strings.ui_settings_rescan;
                            hint: Strings.ui_settings_rescan_hint;
                            hint-short: Strings.ui_settings_rescan_hint_short;
                            NumberField {
                                minimum: 60;
                                maximum: 3600;
                                value <=> root.rescan-seconds;
                                unit: Strings.ui_settings_unit_seconds;
                            }
                        }

                        InlineRow {
                            label: Strings.ui_settings_keep_versions;
                            hint: Strings.ui_settings_keep_versions_hint;
                            hint-short: Strings.ui_settings_keep_versions_hint_short;
                            NumberField {
                                minimum: 0;
                                maximum: 365;
                                value <=> root.keep-versions-days;
                                unit: Strings.ui_settings_unit_days;
                            }
                        }
                    }

                    // ---- Data ----
                    Card {
                        title: Strings.ui_settings_section_data;
                        hint: "";
                        // The way out: a backup that does not need this app, or a move to another.
                        // Only while unlocked — there is nothing readable to write out otherwise.
                        SettingRow {
                            label: Strings.ui_settings_export;
                            hint: Strings.ui_settings_export_hint;
                            hint-short: Strings.ui_settings_export_hint_short;
                            HorizontalLayout {
                                Button {
                                    text: Strings.ui_settings_export_button;
                                    enabled: root.unlocked;
                                    clicked => { root.export-memos(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // Last in Advanced because it is the row someone is sent to rather than one
                        // they go looking for: a button, not a value.
                        SettingRow {
                            label: Strings.ui_settings_log;
                            hint: Strings.ui_settings_log_hint;
                            hint-short: Strings.ui_settings_log_hint_short;
                            HorizontalLayout {
                                Button {
                                    text: Strings.ui_settings_log_open;
                                    clicked => { root.open-log(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }

            // Outside the scrolling part, above the buttons it answers: it sat at the bottom of
            // the scroll, so "saved" — and "you have unsaved changes" when Close was refused —
            // happened out of sight unless the settings had been scrolled to the end.
            if root.status != "": Text {
                text: root.status;
                font-size: 11px;
                color: root.close-warned ? #e7b76a : #a8d0a8;
                wrap: word-wrap;
            }

            Text {
                text: Strings.ui_settings_version + " " + root.app-version;
                font-size: 11px;
                color: #8a8375;
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: Strings.ui_settings_lock_now;
                    enabled: root.unlocked;
                    clicked => { root.lock-now(); }
                }
                Button {
                    text: Strings.ui_settings_security;
                    enabled: root.unlocked;
                    clicked => { root.open-security(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: Strings.ui_settings_close;
                    clicked => { root.close-requested(); }
                }
                PrimaryButton {
                    text: Strings.ui_settings_save;
                    clicked => { root.apply(); }
                }
            }
        }
    }
}
