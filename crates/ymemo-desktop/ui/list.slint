import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
import { Strings } from "@i18n";
import { Palette, IconButton, Glyph } from "theme.slint";
import { PairingPanel, SharedDeviceRow } from "pairing.slint";


// One row of the list. Rust flattens the group tree and tags each row with a depth, since
// Slint has no tree view and this is drawn as an indented list.
export struct ListRow {
    id: string,
    title: string,
    color: string,     // memo accent color, ignored for groups
    depth: int,        // indent level
    is-group: bool,
    expanded: bool,
    child-count: int,
    // Whether the memo has a photo on it, so one with nothing written is not an untitled row
    // beside another untitled row.
    has-photo: bool,
    // The folder this row lives in, filled **only while searching**. A search sets the tree
    // aside and lists the matches flat, which answers "where is the memo that said X" with
    // the memo but not the where — two rows called "회의" in two folders came back looking
    // like the same memo twice.
    folder: string,
}


// ---------------------------------------------------------------------------
// Memo list window, toggled from the tray icon. Clicking a row opens its sticky; the left
// accent shows the sticky's color.
// ---------------------------------------------------------------------------
export component ListWindow inherits Window {
    // The vault's own name in the task bar too, so two vaults open side by side are told
    // apart there as well as on screen.
    title: root.vault-title == "" ? Strings.ui_list_heading : root.vault-title;
    // Five header buttons squeeze the title below this width. It is a minimum and not only
    // a preference because a Window whose root is a layout takes the layout's natural size
    // and ignores `preferred-width` — which left an empty list 141px wide, with its own
    // "no memos yet" line wrapped over four lines.
    preferred-width: 340px;
    preferred-height: 420px;
    min-width: 320px;
    min-height: 260px;
    background: #2e2b27;

    // What this vault is called. Empty until it is named, and then the heading says "Ymemo".
    // It lives in the synced document, so every paired device shows the same one.
    in-out property <string> vault-name;
    // The same name again, as it is really spelled: the line above is drawn by Slint and goes
    // through `hangul.rs`, this one goes to the desktop's own title bar and must not.
    in property <string> vault-title;
    callback rename-vault(string);
    // Whether the heading is being edited right now.
    private property <bool> naming: false;

    in property <[ListRow]> rows;
    // What is typed in the find box. Rust filters the model on it; empty shows the tree.
    in-out property <string> query: "";
    callback search(string);
    // Set while a delete can still be taken back, and the line the bar shows.
    in property <string> undo-message: "";
    callback undo-delete();
    // A write that did not happen. Empty unless something failed; stays until dismissed.
    in-out property <string> notice: "";
    in property <bool> sync-available: false;
    in property <string> my-pairing-code;
    in property <image> qr-image;
    in property <string> peer-message;
    in property <string> lan-pair-code;
    in property <string> lan-message;
    // Set while a peer registered from here has not allowed the request yet; the eight
    // characters its own screen shows, so the user can see the two agree.
    in property <string> pair-waiting-code;
    in property <[SharedDeviceRow]> shared-devices;
    callback lan-join(string);
    callback unshare(string);
    // Id of the group being renamed; Rust puts a freshly created group straight into it.
    in-out property <string> editing-id: "";
    in-out property <string> editing-text: "";
    callback open-memo(string);            // memo id
    callback new-memo();
    callback new-group();
    callback toggle-group(string);         // expand/collapse, device-local state
    callback rename-group(string, string); // id, new name
    // id, is-group, palette key. Folders and memos both carry a colour and both sync it.
    callback set-row-color(string, bool, string);
    // id, is-group: opens the past versions of that row.
    callback show-history(string, bool);
    // Row whose inline palette is open; empty means none.
    in-out property <string> coloring-id: "";
    callback delete-row(string, bool);     // id, is-group
    callback move-row(int, int);           // source row, drop row (out of range = top level)
    callback reorder-row(int, int);        // source row, gap to drop it in (0 = above everything)
    callback add-peer(string);
    // Pairing panel open/close; Rust resizes the window, as in LockWindow.
    callback sync-toggled(bool);
    callback open-settings();
    callback lock-now();
    // Newer release, empty when there is none; the banner below opens its page.
    in property <string> update-version;
    callback open-update();

    private property <bool> show-sync: false;
    changed show-sync => { root.sync-toggled(self.show-sync); }
    // Drag state: the grabbed row and where the pointer is, in row units — 3.5 is the middle
    // of row 3. Rows are uniform, so this is the whole geometry the drop needs. -1 = no drag.
    private property <int> drag-source: -1;
    private property <float> drag-at: -1;
    // Whether the row being dragged is a folder. Folders keep the old behaviour — dropped
    // *on* a row, never *between* two — because what is being arranged here is the memos
    // inside a folder, and a folder's own place comes from the tree.
    private property <bool> drag-is-group: false;

    private property <int> drag-under: Math.floor(root.drag-at);
    private property <float> drag-frac: root.drag-at - root.drag-under;
    // Dropping into a folder rather than between two rows: the pointer has to be in the
    // middle of a folder's row. The outer quarters are the gaps above and below it, so a
    // folder never swallows a drop meant to land next to it.
    private property <bool> drag-into-folder: root.drag-source != -1 && !root.drag-is-group
        && root.drag-under >= 0 && root.drag-under < root.rows.length
        && root.rows[root.drag-under].is-group
        && root.drag-frac > 0.25 && root.drag-frac < 0.75;
    // The row a drop would go *into*, and the gap it would go *between*; one or the other.
    private property <int> drag-into: root.drag-into-folder ? root.drag-under : -1;
    private property <int> drag-gap: root.drag-source == -1 || root.drag-is-group
        || root.drag-into-folder ? -1
        : (root.drag-frac >= 0.5 ? root.drag-under + 1 : root.drag-under);

    // How far the rows either side of the gap lean away from it. The row keeps its height and
    // its touch area — only what is drawn moves — because the drop position is worked out
    // from the pointer against a **fixed** row height, and rows that changed size while being
    // aimed at would move the target out from under the pointer.
    private property <length> part: 5px;

    // Spring-loaded folders: hold a memo over a closed folder and it opens, so the memo can
    // be put *between* the ones inside rather than only "in there somewhere". A folder with
    // nothing in it has nothing to open, and one already open is left alone — otherwise this
    // would sit there shutting and opening it for as long as the pointer rests.
    private property <string> spring-group: root.drag-into != -1
        && !root.rows[root.drag-into].expanded
        && root.rows[root.drag-into].child-count > 0
        ? root.rows[root.drag-into].id : "";
    Timer {
        // Long enough that passing over a folder on the way somewhere else does not open it.
        interval: 550ms;
        running: root.spring-group != "";
        triggered() => { root.toggle-group(root.spring-group); }
    }
    // Whether this press became a drag, so its release is not taken for a click.
    private property <bool> did-drag: false;

    // Row height; drag distance is converted to rows with it, so it must stay fixed.
    private property <length> row-h: 34px;
    // Whether the heading is currently standing in for a toolbar button's name.
    private property <bool> tip-showing: b-lock.hovering || b-gear.hovering || b-link.hovering
        || b-folder.hovering || b-plus.hovering;

    // Stores the vault's new name and leaves the heading's edit mode.
    function finish-naming(name: string) {
        root.naming = false;
        root.rename-vault(name);
    }

    // Commits the name being edited and leaves edit mode.
    function commit-edit() {
        if (root.editing-id != "") {
            root.rename-group(root.editing-id, root.editing-text);
            root.editing-id = "";
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 4px;
            // The heading is three things in one place: the vault's name, the field that
            // renames it, and — while the pointer is on a toolbar button — that button's
            // label. Cheaper than a tooltip and always in the same spot.
            if root.naming: LineEdit {
                horizontal-stretch: 1;
                // A LineEdit asks for more room than the heading it replaces, and in a window
                // at its minimum width that pushed the last toolbar button off the edge — so
                // the field is allowed to be narrow instead.
                min-width: 60px;
                text: root.vault-name;
                placeholder-text: Strings.ui_list_heading;
                // The field is created by this very `if`, so nothing has focus until it asks
                // for it — the same way a group's name field does two hundred lines below.
                // Selected, not just focused: the box opens holding the current name, and a
                // caret parked in front of it turns typing a new name into appending to the
                // old one.
                init => { self.focus(); self.select-all(); }
                accepted => { root.finish-naming(self.text); }
                // Escape backs out. Clicking elsewhere in the window does not move the focus
                // — nothing else in the list takes it — so without a key that says "never
                // mind" the heading stayed a text field, and with it the toolbar stayed one
                // button narrower.
                //
                // The old name is put back before the field goes, because losing focus is
                // itself a commit here (see below) and tearing the field down may deliver one
                // — `set_name` ignores a name that did not change, so this cannot fight it.
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        self.text = root.vault-name;
                        root.naming = false;
                        return accept;
                    }
                    return reject;
                }
                // Clicking away is as much an answer as pressing return, and a heading stuck
                // in edit mode because the pointer moved is a trap. `set_name` ignores a name
                // that did not change, so the two paths cannot fight.
                changed has-focus => {
                    if (!self.has-focus) { root.finish-naming(self.text); }
                }
            }
            if !root.naming: Rectangle {
                horizontal-stretch: 1;
                Text {
                    width: 100%;
                    height: 100%;
                    text: b-lock.hovering ? Strings.ui_list_tip_lock
                        : b-gear.hovering ? Strings.ui_list_tip_settings
                        : b-link.hovering ? Strings.ui_list_tip_sync
                        : b-folder.hovering ? Strings.ui_list_tip_new_group
                        : b-plus.hovering ? Strings.ui_list_tip_new_memo
                        : root.vault-name == "" ? Strings.ui_list_heading
                        : root.vault-name;
                    font-size: root.tip-showing ? 12px : 16px;
                    font-weight: root.tip-showing ? 400 : 700;
                    color: root.tip-showing ? #cfc8b6
                        : name-ta.has-hover ? #ffffff
                        : #f0ead6;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Click the name to change it. Nothing marks it as editable at rest — a
                // heading covered in affordances is worse than one you find by trying — so
                // it lights up under the pointer and says so through the accessible label.
                name-ta := TouchArea {
                    mouse-cursor: text;
                    accessible-role: button;
                    accessible-label: Strings.ui_list_rename_vault;
                    clicked => {
                        root.commit-edit();
                        root.naming = true;
                    }
                }
            }
            b-lock := IconButton {
                icon: "lock";
                label: Strings.ui_list_tip_lock;
                clicked => { root.commit-edit(); root.lock-now(); }
            }
            b-gear := IconButton {
                icon: "gear";
                label: Strings.ui_list_tip_settings;
                clicked => { root.commit-edit(); root.open-settings(); }
            }
            b-link := IconButton {
                icon: "link";
                label: Strings.ui_list_tip_sync;
                clicked => { root.show-sync = !root.show-sync; }
            }
            b-folder := IconButton {
                icon: "folder";
                label: Strings.ui_list_tip_new_group;
                clicked => { root.commit-edit(); root.new-group(); }
            }
            b-plus := IconButton {
                icon: "plus";
                label: Strings.ui_list_tip_new_memo;
                clicked => { root.commit-edit(); root.new-memo(); }
            }
        }

        // A new release: one line, dismissed by updating or by turning the check off in
        // settings. Never a dialog — this is a memo app, not an updater.
        if root.update-version != "": Rectangle {
            height: 26px;
            border-radius: 6px;
            background: #3c3730;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: Strings.ui_update_available + " " + root.update-version;
                    font-size: 11px;
                    color: #e8d98a;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: Strings.ui_update_open;
                    font-size: 11px;
                    color: #9ec5e8;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-update(); }
            }
        }

        if root.show-sync: VerticalLayout {
            vertical-stretch: 1;
            PairingPanel {
                available: root.sync-available;
                my-code: root.my-pairing-code;
                qr: root.qr-image;
                message: root.peer-message;
                lan-code: root.lan-pair-code;
                lan-message: root.lan-message;
                waiting-code: root.pair-waiting-code;
                devices: root.shared-devices;
                ink: #d8d2c2;
                add-peer(code) => { root.add-peer(code); }
                lan-join(code) => { root.lan-join(code); }
                unshare(id) => { root.unshare(id); }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // Find. Always on screen rather than behind a sixth toolbar button: a memo app whose
        // search has to be discovered is a memo app without one, and the row costs 24px.
        // While it has something in it the list is a flat list of matches, so the tree
        // controls below (indent, drag, folders) are the ones that stand down, not this.
        if !root.show-sync: Rectangle {
            height: 24px;
            border-radius: 6px;
            background: #ffffff10;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 4px;
                Rectangle {
                    width: 14px;
                    Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 13px;
                        height: 13px;
                        name: "search";
                        stroke: #b0a99a;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    // The placeholder sits *under* the field rather than beside it: a
                    // TextInput has none of its own, and a sibling in the layout would take
                    // room from the text it is standing in for.
                    if root.query == "": Text {
                        x: 0px;
                        width: 100%;
                        text: Strings.ui_list_search;
                        font-size: 12px;
                        color: #7d7768;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    find := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.query;
                        font-size: 12px;
                        color: #ece7db;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: Strings.ui_list_search;
                        edited => { root.search(self.text); }
                        // Escape clears rather than closes: the field has no close of its own,
                        // and a search left standing is what would make the list look half
                        // empty ten minutes later.
                        key-pressed(ev) => {
                            if (ev.text == Key.Escape) {
                                self.text = "";
                                root.search("");
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
                if root.query != "": IconButton {
                    width: 20px;
                    height: 20px;
                    icon: "close";
                    label: Strings.ui_list_search;
                    clicked => { find.text = ""; root.search(""); }
                }
            }
        }

        // A change that could not be written — a full disk, a vault directory gone read-only,
        // a removable drive pulled out. Nothing else in this window says so, and a memo app
        // that silently drops what was typed is the one failure it cannot have. No timeout:
        // this is not an offer that expires, it is a fact about the vault, and it stays until
        // it is read and dismissed.
        if root.notice != "": Rectangle {
            height: 26px;
            border-radius: 6px;
            background: #4a2f2f;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;
                Text {
                    text: root.notice;
                    font-size: 11px;
                    color: #f0c9c9;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                dismiss := TouchArea {
                    width: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: Strings.ui_list_notice_dismiss;
                    Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 11px;
                        height: 11px;
                        name: "close";
                        stroke: dismiss.has-hover ? #ffffff : #f0c9c9;
                    }
                    clicked => { root.notice = ""; }
                }
            }
        }

        // What a delete left behind, for as long as it can still be taken back. A bar and not
        // a dialog: the delete already happened, and a question in front of every one of them
        // is a tax on the many that were meant.
        if root.undo-message != "": Rectangle {
            height: 26px;
            border-radius: 6px;
            background: #43352f;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;
                Text {
                    text: root.undo-message;
                    font-size: 11px;
                    color: #e8d0c4;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                undo-btn := TouchArea {
                    width: 78px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: Strings.ui_list_undo;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 13px;
                            Glyph {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 13px;
                                height: 13px;
                                name: "undo";
                                stroke: undo-btn.has-hover ? #ffffff : #9ec5e8;
                            }
                        }
                        Text {
                            text: Strings.ui_list_undo;
                            font-size: 11px;
                            font-weight: 700;
                            color: undo-btn.has-hover ? #ffffff : #9ec5e8;
                            vertical-alignment: center;
                        }
                    }
                    clicked => { root.undo-delete(); }
                }
            }
        }

        // An empty list still has the whole window to fill, and the line saying so belongs in
        // the middle of that space rather than pinned to the top-left corner of it.
        if !root.show-sync && root.rows.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 6px;
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: root.query == "" ? Strings.ui_list_empty : Strings.ui_list_search_none;
                horizontal-alignment: center;
                font-size: 13px;
                color: #d8d2c2;
                wrap: word-wrap;
            }
            // What to do about it, quieter than the line above and only when the list is
            // empty: a search that found nothing is not the place to explain the + button.
            if root.query == "": Text {
                text: Strings.ui_list_empty_hint;
                horizontal-alignment: center;
                font-size: 11px;
                color: #8f887a;
                wrap: word-wrap;
            }
        }

        if !root.show-sync && root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for row[idx] in root.rows: Rectangle {
                height: root.row-h;
                border-radius: 6px;
                // The dragged row dims, a folder about to swallow it highlights.
                opacity: root.drag-source == idx ? 0.45 : 1;
                animate opacity { duration: 120ms; easing: ease-out; }
                // A folder and what is in it read as one block. The folder's own row sits a
                // shade above the window and the rows under it half a shade, so the group is
                // a band rather than four lines that happen to be indented — the indent alone
                // is 14px, which is not much to tell "inside Work" from "next to Work".
                // Slight on purpose: both stay under the hover and the drop highlight, which
                // still have to be the brightest things on a row.
                background: root.drag-into == idx ? #7db8ec55
                          : ta.has-hover ? #ffffff1a
                          : row.is-group ? #ffffff12
                          : row.depth > 0 ? #ffffff08
                          : transparent;
                animate background { duration: 120ms; easing: ease-out; }

                // The line the memo would land on, in the space the two rows either side have
                // just made for it. Drawn on the row below the gap, and on the bottom edge of
                // the last row for the gap past the end of the list.
                if root.drag-gap == idx: Rectangle {
                    x: 6px + row.depth * 14px;
                    // Straddles the row's top edge, except on the first row, where the half
                    // above it falls outside the list and is clipped away.
                    y: idx == 0 ? 0px : -1px;
                    width: parent.width - self.x - 8px;
                    height: 2px;
                    border-radius: 1px;
                    background: #7db8ec;
                }
                if root.drag-gap == idx + 1 && idx == root.rows.length - 1: Rectangle {
                    x: 6px + row.depth * 14px;
                    y: parent.height - 1px;
                    width: parent.width - self.x - 8px;
                    height: 2px;
                    border-radius: 1px;
                    background: #7db8ec;
                }

                // Touch area underneath: the Text above does not consume input, so it lands
                // here — except while renaming, where the LineEdit on top takes it first.
                ta := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.did-drag = false;
                        }
                        if (ev.kind == PointerEventKind.up) {
                            if (root.drag-source != -1) {
                                if (root.drag-is-group) {
                                    // Unchanged: a folder is dropped on a row, and past the
                                    // end of the list means the top level.
                                    if (root.drag-under != root.drag-source) {
                                        root.move-row(root.drag-source, root.drag-under);
                                    }
                                } else if (root.drag-into != -1) {
                                    if (root.drag-into != root.drag-source) {
                                        root.move-row(root.drag-source, root.drag-into);
                                    }
                                // The two gaps touching the memo are where it already is, so
                                // a drop there is not a move and must not write anything.
                                } else if (root.drag-gap != root.drag-source
                                        && root.drag-gap != root.drag-source + 1) {
                                    root.reorder-row(root.drag-source, root.drag-gap);
                                }
                            }
                            root.drag-source = -1;
                            root.drag-at = -1;
                        }
                    }
                    moved => {
                        // Nothing is dragged while a search is on: these rows are the matches,
                        // flattened out of the tree, so a drop between two of them would mean
                        // a place in a list that is not the one being arranged.
                        if (root.query != "") { return; }
                        // Small movements stay clicks; past the threshold it is a drag.
                        if (self.mouse-y - self.pressed-y > 4px || self.pressed-y - self.mouse-y > 4px) {
                            root.did-drag = true;
                            root.drag-source = idx;
                            root.drag-is-group = row.is-group;
                        }
                        if (root.drag-source != -1) {
                            // Rows are uniform, and `mouse-y` is measured from this row's top,
                            // so this is the pointer's position in row units — fraction and
                            // all, which is what tells a gap from the middle of a folder.
                            root.drag-at = idx + self.mouse-y / root.row-h;
                        }
                    }
                    clicked => {
                        if (!root.did-drag) {
                            root.commit-edit();
                            if (row.is-group) {
                                root.toggle-group(row.id);
                            } else {
                                root.open-memo(row.id);
                            }
                        }
                    }
                    double-clicked => {
                        // Double click renames a group in place.
                        if (row.is-group) {
                            root.editing-text = row.title;
                            root.editing-id = row.id;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 6px + row.depth * 14px; // tree indent
                    padding-right: 4px;
                    spacing: 6px;
                    // Lean away from the gap, so the two rows either side of the drop visibly
                    // make room. The row itself does not move; this is only what it draws.
                    y: root.drag-gap == idx ? root.part
                     : root.drag-gap == idx + 1 ? -root.part
                     : 0px;
                    animate y { duration: 130ms; easing: ease-out; }

                    // The disclosure column. Empty on a memo, and on a folder with nothing in
                    // it, but **always there**: without it a folder's own row started 32px
                    // further in than a memo's at the same depth, so a top-level folder
                    // looked like it was inside something.
                    Rectangle {
                        width: 14px;
                        if row.is-group && row.child-count > 0: Glyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 11px;
                            height: 11px;
                            name: row.expanded ? "chevron-down" : "chevron-right";
                            stroke: #b0a99a;
                            stroke-width: 1.5px;
                        }
                    }

                    // What the row *is*, in its own colour, and the way in to changing that
                    // colour. One mark, not two: a folder used to carry a thin outline folder
                    // **and** the same colour strip a memo has, which said "folder" twice and
                    // "memo" once in the same breath. The filled shape reads at this size,
                    // where the outline's tab was a pixel and a half wide and vanished.
                    Rectangle {
                        width: 18px;
                        if row.is-group: Glyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 17px;
                            height: 17px;
                            name: "folder-solid";
                            fill: Palette.swatch(row.color);
                        }
                        if !row.is-group: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 5px;
                            height: 22px;
                            border-radius: 2.5px;
                            background: Palette.swatch(row.color);
                        }
                        swatch-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.commit-edit();
                                root.coloring-id = root.coloring-id == row.id ? "" : row.id;
                            }
                        }
                    }

                    // Inline palette, in place of the name while it is open.
                    if root.coloring-id == row.id: HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        alignment: start;
                        for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 9px;
                            background: Palette.swatch(key);
                            border-width: row.color == key ? 3px : 1px;
                            border-color: row.color == key ? #ffffff : #00000040;
                            TouchArea {
                                mouse-cursor: pointer;
                                // Closed *before* the write, not after: `set-row-color`
                                // rebuilds the row model, which destroys this very element,
                                // and anything after that call never runs — which is why the
                                // palette used to stay open over the colour it had just set.
                                clicked => {
                                    root.coloring-id = "";
                                    root.set-row-color(row.id, row.is-group, key);
                                }
                            }
                        }
                    }

                    // The name turns into a LineEdit only for the group being renamed.
                    if root.coloring-id != row.id && root.editing-id == row.id: LineEdit {
                        horizontal-stretch: 1;
                        text: row.title;
                        // Selected as well as focused: a new folder arrives here already
                        // called "New folder", and with only the caret placed, typing a name
                        // produced "WorkNew folder".
                        init => { self.focus(); self.select-all(); }
                        edited(t) => { root.editing-text = t; }
                        accepted => { root.commit-edit(); }
                    }
                    if root.coloring-id != row.id && root.editing-id != row.id: Text {
                        text: row.is-group
                            ? (row.title == "" ? Strings.ui_list_group_untitled : row.title)
                            : (row.title == "" ? Strings.ui_list_memo_untitled : row.title);
                        font-size: 14px;
                        font-weight: row.is-group ? 700 : 400;
                        color: row.title == "" ? #9a9384 : #ece7db;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Which folder the match came out of. Only a search fills this in, and
                    // it gives up its room to the title first: the name is what was searched
                    // for, this only says where it was found.
                    if row.folder != "": Text {
                        text: row.folder;
                        font-size: 11px;
                        color: #8d8778;
                        vertical-alignment: center;
                        overflow: elide;
                        // Out of the way of the two buttons that appear over it on hover.
                        opacity: ta.has-hover ? 0 : 1;
                        animate opacity { duration: 120ms; easing: ease-out; }
                    }

                    // A memo with a picture on it says so. It matters most for the memo with
                    // nothing written on it at all, which would otherwise be one "(untitled)"
                    // beside another.
                    if row.has-photo: Rectangle {
                        width: 15px;
                        Glyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 13px;
                            height: 13px;
                            name: "photo";
                            stroke: #8d8778;
                            // Thinner than a button's: this sits at 13px beside 14px text and
                            // is a mark, not a control.
                            stroke-width: 1.1px;
                        }
                    }

                    if row.is-group: Text {
                        text: row.child-count > 0 ? row.child-count : "";
                        font-size: 11px;
                        color: #8d8778;
                        vertical-alignment: center;
                    }

                    // Past versions and delete, for folders and memos alike. Both appear on
                    // hover only, so neither competes with the name for room — and, more to
                    // the point, so they behave alike: delete used to be the one icon always
                    // drawn on every row, which left the only button that loses writing
                    // permanently on screen while the harmless one beside it hid. What
                    // softens it now is the undo bar above, not a dialog in front of it.
                    //
                    // The two live in one `if` so each can see the other's hover: the row's
                    // own TouchArea loses `has-hover` to whichever of these the pointer is
                    // over, and without the other two terms an icon would blink out exactly
                    // as it was being aimed at.
                    if root.coloring-id != row.id: HorizontalLayout {
                        spacing: 0px;
                        Rectangle {
                            width: 20px;
                            opacity: ta.has-hover || hist-ta.has-hover || del-ta.has-hover ? 1 : 0;
                            Glyph {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                name: "history";
                                stroke: #b0a99a;
                            }
                            hist-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: Strings.ui_sticky_history;
                                clicked => {
                                    root.commit-edit();
                                    root.show-history(row.id, row.is-group);
                                }
                            }
                        }
                        del-ta := TouchArea {
                            width: 28px;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: Strings.ui_list_tip_delete;
                            Glyph {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 15px;
                                height: 15px;
                                name: "trash";
                                stroke: del-ta.has-hover ? #e8a0a0 : #b0a99a;
                                opacity: !(ta.has-hover || hist-ta.has-hover || del-ta.has-hover) ? 0
                                    : del-ta.has-hover ? 1 : 0.4;
                            }
                            clicked => { root.commit-edit(); root.delete-row(row.id, row.is-group); }
                        }
                    }
                }
            }
        }
    }
}
