// Entry file: gathers the windows and exposes them to Rust (`slint::include_modules!`).
//
// The UI itself lives in one file per screen:
//   theme.slint    - sticky color palette
//   pairing.slint  - device linking panel, shared by the lock and list windows
//   lock.slint     - lock window
//   list.slint     - memo list window
//   sticky.slint   - sticky window
//   settings.slint - settings window
//   security.slint - master password and recovery code
//   history.slint  - past versions of one memo or folder
//
// Strings are generated by build.rs from i18n/*.json into the `Strings` global, one property
// per key. It has to be re-exported here for Rust to fill it in; only exported globals are
// visible.
import { Strings } from "@i18n";
export { Strings }

import { Palette } from "theme.slint";
export { Palette }

import { SharedDeviceRow } from "pairing.slint";
export { SharedDeviceRow }

import { LockWindow } from "lock.slint";
export { LockWindow }

import { ListRow, ListWindow } from "list.slint";
export { ListRow, ListWindow }

import { StickyWindow } from "sticky.slint";
export { StickyWindow }

import { SettingsWindow } from "settings.slint";
export { SettingsWindow }

import { SecurityWindow } from "security.slint";
export { SecurityWindow }

import { RevisionRow, HistoryWindow } from "history.slint";
export { RevisionRow, HistoryWindow }
