// 진입 파일: 창들을 모아 Rust(`slint::include_modules!`)에 노출한다.
//
// 실제 UI 는 화면별 파일에 있다:
//   theme.slint    — 스티커 색 팔레트
//   pairing.slint  — 기기 연결 패널 (잠금·목록 창이 공유)
//   lock.slint     — 잠금 창
//   list.slint     — 메모 목록 창
//   sticky.slint   — 스티커 창
//   settings.slint — 환경설정 창
//
// 문구는 저장소 루트 i18n/*.json 에서 build.rs 가 생성한다 (Strings 전역 = 키마다 프로퍼티 하나).
// Rust 가 문구를 채워 넣으려면 진입 파일에서 다시 내보내야 한다 (전역은 export 된 것만 보인다).
import { Strings } from "@i18n";
export { Strings }

import { Palette } from "theme.slint";
export { Palette }

import { SharedDeviceRow } from "pairing.slint";
export { SharedDeviceRow }

import { LockWindow } from "lock.slint";
export { LockWindow }

import { ListRow, ListWindow } from "list.slint";
export { ListRow, ListWindow }

import { StickyWindow } from "sticky.slint";
export { StickyWindow }

import { SettingsWindow } from "settings.slint";
export { SettingsWindow }
