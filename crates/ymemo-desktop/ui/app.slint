import { LineEdit, Button, TextEdit, ListView, Slider, SpinBox } from "std-widgets.slint";
// 문구는 저장소 루트 i18n/*.json 에서 build.rs 가 생성한다 (Strings 전역 = 키마다 프로퍼티 하나).
import { Strings } from "@i18n";
// Rust 가 문구를 채워 넣으려면 진입 파일에서 다시 내보내야 한다 (전역은 export 된 것만 보인다).
export { Strings }

// 스티커 팔레트: 색상 키("yellow"/"pink"/"green"/"blue"/"purple") → 실제 색.
// 코어(Memo.color)는 키 문자열만 저장·동기화하고, 실제 색 해석은 여기 한곳에 모은다.
export global Palette {
    // 스티커 본문 배경 (반투명 — 데스크탑 위젯 느낌)
    pure public function bg(key: string) -> color {
        return key == "pink" ? #ffd6e6f2
             : key == "green" ? #d2f0c8f2
             : key == "blue" ? #cfe6fff2
             : key == "purple" ? #e6d6f5f2
             : #fff9b1f2; // yellow (기본)
    }
    // 제목 바 (본문보다 진한 불투명색)
    pure public function bar(key: string) -> color {
        return key == "pink" ? #f7b8ce
             : key == "green" ? #b6e0a8
             : key == "blue" ? #b0d4f2
             : key == "purple" ? #d0b8ec
             : #f4e98c; // yellow
    }
    // 제목 바 글자색 (색상별로 대비 유지)
    pure public function ink(key: string) -> color {
        return key == "pink" ? #7a3350
             : key == "green" ? #35662f
             : key == "blue" ? #2a5578
             : key == "purple" ? #573377
             : #5c5c25; // yellow
    }
    // 팔레트 칩/목록 악센트용 채도 높은 대표색 (불투명)
    pure public function swatch(key: string) -> color {
        return key == "pink" ? #ff9fc0
             : key == "green" ? #8fd678
             : key == "blue" ? #7db8ec
             : key == "purple" ? #b98fe0
             : #ffe15c; // yellow
    }
}


// 기기 페어링 패널.
//  - 기본: 같은 네트워크에서 6자리 코드로 연결 (이 기기 코드 표시 + 상대 코드 입력).
//  - 접이식 폴백: QR / 긴 device-id 직접 등록 (다른 네트워크용).
// 현재 이 vault 를 공유 중인 다른 기기 한 대.
export struct SharedDeviceRow {
    id: string,        // syncthing device-id (해제 시 식별자)
    name: string,      // 사람이 읽을 이름 (없으면 빈 문자열 → id 축약 표시)
    connected: bool,   // 지금 연결돼 있는지
}

// 페어링 패널 상단의 탭 버튼 하나. 두 연결 방식을 한 번에 한쪽만 보여주기 위한 것으로,
// 이렇게 나눠야 각 화면이 스크롤 없이 창 안에 다 들어온다.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> ink;
    callback clicked();

    height: 26px;
    background: root.active ? #ffffff26 : #ffffff08;
    border-width: 1px;
    border-color: root.active ? #ffffff59 : #ffffff1f;
    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 11px;
        font-weight: root.active ? 700 : 400;
        color: root.ink;
        opacity: root.active ? 1.0 : 0.7;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component PairingPanel inherits VerticalLayout {
    in property <bool> available;
    in property <string> my-code;          // 이 기기의 긴 device-id 코드 (폴백)
    in property <image> qr;
    in property <string> message;          // 수동 등록 결과
    in property <string> lan-code;         // 이 기기의 현재 6자리 코드
    in property <string> lan-message;      // LAN 연결 결과
    in property <[SharedDeviceRow]> devices;  // 현재 공유 중인 기기들
    in property <color> ink: #5c5c25;
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);              // 인자: 해제할 device-id

    // 지금 보고 있는 탭. false = 같은 Wi-Fi(6자리), true = 다른 네트워크(QR·device-id).
    private property <bool> remote: false;

    spacing: 8px;

    if root.available: VerticalLayout {
        spacing: 8px;
        Text {
            text: Strings.ui_pair_title;
            font-size: 13px;
            font-weight: 700;
            color: root.ink;
        }

        // ---- 연결 방식 탭 ----
        HorizontalLayout {
            TabButton {
                label: Strings.ui_pair_tab_lan;
                active: !root.remote;
                ink: root.ink;
                clicked => { root.remote = false; }
            }
            TabButton {
                label: Strings.ui_pair_tab_remote;
                active: root.remote;
                ink: root.ink;
                clicked => { root.remote = true; }
            }
        }

        // ---- 방식 1: 같은 네트워크 — 6자리 코드 ----
        if !root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_lan_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            // 이 기기의 6자리 코드 (크게).
            Text {
                text: root.lan-code == "" ? "------" : root.lan-code;
                font-size: 26px;
                font-weight: 800;
                letter-spacing: 3px;
                color: root.ink;
                horizontal-alignment: center;
            }
            // 상대 코드 입력 → LAN 연결.
            HorizontalLayout {
                spacing: 6px;
                lan := LineEdit {
                    placeholder-text: Strings.ui_pair_lan_placeholder;
                    input-type: InputType.number;
                    accepted => { root.lan-join(self.text); self.text = ""; }
                }
                Button {
                    text: Strings.ui_pair_lan_connect;
                    clicked => { root.lan-join(lan.text); lan.text = ""; }
                }
            }
            if root.lan-message != "": Text {
                text: root.lan-message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }
        }

        // ---- 방식 2 (폴백): 다른 네트워크 — QR / 긴 device-id ----
        if root.remote: VerticalLayout {
            spacing: 6px;
            Text {
                text: Strings.ui_pair_remote_hint;
                font-size: 10px;
                color: root.ink;
                opacity: 0.8;
                wrap: word-wrap;
            }
            Image {
                source: root.qr;
                width: 120px;
                height: 120px;
                image-rendering: pixelated;
            }
            Text {
                text: root.my-code;
                font-size: 9px;
                color: root.ink;
                opacity: 0.75;
                wrap: char-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                peer := LineEdit {
                    placeholder-text: Strings.ui_pair_remote_placeholder;
                    accepted => { root.add-peer(self.text); }
                }
                Button {
                    text: Strings.ui_pair_remote_register;
                    clicked => { root.add-peer(peer.text); }
                }
            }
            if root.message != "": Text {
                text: root.message;
                font-size: 11px;
                color: root.ink;
                wrap: word-wrap;
            }
        }

        // ---- 현재 공유 중인 기기 목록 (탭과 무관하게 항상 보인다) ----
        Rectangle { height: 1px; background: root.ink; opacity: 0.25; }
        Text {
            text: Strings.ui_pair_devices_title;
            font-size: 12px;
            font-weight: 700;
            color: root.ink;
        }
        if root.devices.length == 0: Text {
            text: Strings.ui_pair_devices_empty;
            font-size: 11px;
            color: root.ink;
            opacity: 0.7;
        }
        for dev in root.devices: HorizontalLayout {
            spacing: 6px;
            // 연결 상태 점.
            Text {
                text: dev.connected ? "●" : "○";
                font-size: 11px;
                color: dev.connected ? #6fae6f : root.ink;
                vertical-alignment: center;
            }
            Text {
                text: dev.name;
                font-size: 11px;
                color: root.ink;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: Strings.ui_pair_unshare;
                clicked => { root.unshare(dev.id); }
            }
        }
    }
    if !root.available: Text {
        text: Strings.ui_pair_unavailable;
        font-size: 12px;
        color: #d98a8a;
        wrap: word-wrap;
    }
}

// 목록 창의 한 행. 그룹 트리를 Rust 가 미리 평탄화해 depth 를 붙여 넘긴다
// (Slint 에 트리 뷰가 없으므로 "들여쓰기 된 리스트"로 그린다).
export struct ListRow {
    id: string,
    title: string,
    color: string,     // 메모 색 악센트 (그룹이면 무시)
    depth: int,        // 들여쓰기 단계
    is-group: bool,
    expanded: bool,
    child-count: int,
}

// ---------------------------------------------------------------------------
// 잠금 창: 시작 시 마스터 암호 입력. unlock 성공 후엔 숨겨진다.
// ---------------------------------------------------------------------------
export component LockWindow inherits Window {
    title: Strings.ui_lock_title;
    preferred-width: 320px;
    preferred-height: 300px;
    min-height: 200px;
    background: #2e2b27;

    in property <string> lock-message;
    in property <bool> sync-available: false;
    in property <string> my-pairing-code;
    in property <image> qr-image;
    in property <string> peer-message;
    in property <string> lan-pair-code;
    in property <string> lan-message;
    // vault.json 존재 여부. true = 기존 vault(잠금 해제), false = 새 기기(선택 화면).
    // Rust 가 페어링으로 vault.json 이 도착하면 true 로 바꿔 잠금 해제로 전환한다.
    in property <bool> vault-exists: false;
    in property <[SharedDeviceRow]> shared-devices;
    callback unlock(string);
    callback create-vault(string);
    callback add-peer(string);
    callback lan-join(string);
    callback unshare(string);
    // 페어링 패널이 열리고 닫힐 때 — Rust 가 창을 패널이 다 보이는 크기로 넓혔다 되돌린다
    // (스크롤 없이 한눈에 보이게 하는 것이 목적).
    callback sync-toggled(bool);

    // Rust 가 vault 도착 시 닫을 수 있도록 in-out.
    in-out property <bool> show-sync: false;
    changed show-sync => { root.sync-toggled(self.show-sync); }
    // 새 기기에서 "새로 만들기"를 골라 암호 설정 단계로 들어갔는가.
    private property <bool> creating: false;
    // 암호 입력칸의 내용. LineEdit 이 조건부 블록 안에 있어 밖에서 id 로 못 잡으므로
    // root 프로퍼티에 양방향으로 묶어 두고, 잠글 때 Rust 가 이걸 비운다.
    private property <string> password-text;
    public function clear-password() { root.password-text = ""; }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Ymemo 🔒";
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "🔗";
                clicked => { root.show-sync = !root.show-sync; }
            }
        }

        if root.show-sync: VerticalLayout {
            vertical-stretch: 1;
            PairingPanel {
                available: root.sync-available;
                my-code: root.my-pairing-code;
                qr: root.qr-image;
                message: root.peer-message;
                lan-code: root.lan-pair-code;
                lan-message: root.lan-message;
                devices: root.shared-devices;
                ink: #d8d2c2;
                add-peer(code) => { root.add-peer(code); }
                lan-join(code) => { root.lan-join(code); }
                unshare(id) => { root.unshare(id); }
            }
            // 남는 세로 공간은 아래로 — 패널이 위에 붙어 보이도록.
            Rectangle { vertical-stretch: 1; }
        }

        if !root.show-sync: VerticalLayout {
            spacing: 8px;
            Text {
                text: root.lock-message;
                font-size: 12px;
                color: #e79a9a;
                wrap: word-wrap;
            }

            // 기존 vault: 마스터 암호로 잠금 해제.
            if root.vault-exists: HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: Strings.ui_lock_password_placeholder;
                    input-type: InputType.password;
                    text <=> root.password-text;
                    accepted => { root.unlock(self.text); }
                }
                Button {
                    text: Strings.ui_lock_open;
                    clicked => { root.unlock(root.password-text); }
                }
            }

            // 새 기기 첫 실행: 어떻게 시작할지 선택.
            if !root.vault-exists && !root.creating: VerticalLayout {
                spacing: 8px;
                Text {
                    text: Strings.ui_lock_start_question;
                    font-size: 13px;
                    color: #f0ead6;
                    wrap: word-wrap;
                }
                Button {
                    text: Strings.ui_lock_create_choice;
                    clicked => { root.creating = true; }
                }
                Button {
                    text: Strings.ui_lock_connect_choice;
                    enabled: root.sync-available;
                    clicked => { root.show-sync = true; }
                }
                Text {
                    text: Strings.ui_lock_start_hint;
                    font-size: 11px;
                    color: #b8b2a2;
                    wrap: word-wrap;
                }
            }

            // 새 기기 + "새로 만들기" 선택: 새 마스터 암호 설정.
            if !root.vault-exists && root.creating: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    npw := LineEdit {
                        placeholder-text: Strings.ui_lock_new_password_placeholder;
                        input-type: InputType.password;
                        accepted => { root.create-vault(self.text); }
                    }
                    Button {
                        text: Strings.ui_lock_create;
                        clicked => { root.create-vault(npw.text); }
                    }
                }
                Button {
                    text: Strings.ui_lock_back;
                    clicked => { root.creating = false; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// 메모 목록 창: 트레이 아이콘 클릭으로 토글된다. 어두운 배경 + 밝은 글자.
// 행 클릭 → 스티커 창 열기. ＋ 새 메모, 🗑 삭제. 왼쪽 악센트로 스티커 색 표시.
// ---------------------------------------------------------------------------
export component ListWindow inherits Window {
    title: "Ymemo";
    // 헤더 버튼이 다섯 개(🔒 ⚙ 🔗 📁 ＋)라 300px 로는 제목이 눌린다.
    preferred-width: 340px;
    preferred-height: 420px;
    background: #2e2b27;

    in property <[ListRow]> rows;
    in property <bool> sync-available: false;
    in property <string> my-pairing-code;
    in property <image> qr-image;
    in property <string> peer-message;
    in property <string> lan-pair-code;
    in property <string> lan-message;
    in property <[SharedDeviceRow]> shared-devices;
    callback lan-join(string);
    callback unshare(string);
    // 이름 편집 중인 그룹 id. Rust 가 그룹을 새로 만들면 바로 편집 상태로 넣는다.
    in-out property <string> editing-id: "";
    in-out property <string> editing-text: "";
    callback open-memo(string);            // 인자: memo id
    callback new-memo();
    callback new-group();
    callback toggle-group(string);         // 펼침/접힘 (기기 로컬 상태)
    callback rename-group(string, string); // id, 새 이름
    callback delete-row(string, bool);     // id, is-group
    callback move-row(int, int);           // 원본 행 index, 놓은 행 index (음수/범위밖 = 최상위)
    callback add-peer(string);
    // 페어링 패널 열림/닫힘 — Rust 가 창 크기를 맞춰 준다 (LockWindow 와 같은 이유).
    callback sync-toggled(bool);
    callback open-settings();
    callback lock-now();

    private property <bool> show-sync: false;
    changed show-sync => { root.sync-toggled(self.show-sync); }
    // 드래그 상태: 잡은 행과 현재 놓을 위치. -1 이면 드래그 중이 아님.
    private property <int> drag-source: -1;
    private property <int> drag-target: -1;
    // 이번 누름이 드래그였나 (드래그 후 클릭이 열기로 오인되지 않도록).
    private property <bool> did-drag: false;

    // 행 높이 — 드래그 시 이동한 행 수를 계산하는 기준이라 고정이어야 한다.
    private property <length> row-h: 34px;

    // 편집 중이던 이름을 저장하고 편집 모드를 끝낸다.
    function commit-edit() {
        if (root.editing-id != "") {
            root.rename-group(root.editing-id, root.editing-text);
            root.editing-id = "";
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Ymemo 📝";
                font-size: 16px;
                font-weight: 700;
                color: #f0ead6;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "🔒";
                clicked => { root.commit-edit(); root.lock-now(); }
            }
            Button {
                text: "⚙";
                clicked => { root.commit-edit(); root.open-settings(); }
            }
            Button {
                text: "🔗";
                clicked => { root.show-sync = !root.show-sync; }
            }
            Button {
                text: "📁";
                clicked => { root.commit-edit(); root.new-group(); }
            }
            Button {
                text: "＋";
                clicked => { root.commit-edit(); root.new-memo(); }
            }
        }

        if root.show-sync: VerticalLayout {
            vertical-stretch: 1;
            PairingPanel {
                available: root.sync-available;
                my-code: root.my-pairing-code;
                qr: root.qr-image;
                message: root.peer-message;
                lan-code: root.lan-pair-code;
                lan-message: root.lan-message;
                devices: root.shared-devices;
                ink: #d8d2c2;
                add-peer(code) => { root.add-peer(code); }
                lan-join(code) => { root.lan-join(code); }
                unshare(id) => { root.unshare(id); }
            }
            Rectangle { vertical-stretch: 1; }
        }

        if !root.show-sync && root.rows.length == 0: Text {
            text: Strings.ui_list_empty;
            font-size: 12px;
            color: #b0a99a;
            wrap: word-wrap;
        }

        if !root.show-sync: ListView {
            vertical-stretch: 1;
            for row[idx] in root.rows: Rectangle {
                height: root.row-h;
                border-radius: 6px;
                // 드래그 중인 행은 흐리게, 놓을 대상은 밝게 강조.
                opacity: root.drag-source == idx ? 0.45 : 1;
                background: root.drag-source != -1 && root.drag-target == idx ? #7db8ec55
                          : ta.has-hover ? #ffffff1a
                          : transparent;

                // 아래에 깔린 터치 영역: 위의 Text 는 입력을 소비하지 않아 여기로 들어온다.
                // (이름 편집 중일 땐 위에 올라온 LineEdit 가 먼저 입력을 가져간다)
                ta := TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.did-drag = false;
                        }
                        if (ev.kind == PointerEventKind.up) {
                            if (root.drag-source != -1 && root.drag-target != root.drag-source) {
                                root.move-row(root.drag-source, root.drag-target);
                            }
                            root.drag-source = -1;
                            root.drag-target = -1;
                        }
                    }
                    moved => {
                        // 살짝 움직인 정도는 클릭으로 두고, 임계값을 넘으면 드래그 시작.
                        if (self.mouse-y - self.pressed-y > 4px || self.pressed-y - self.mouse-y > 4px) {
                            root.did-drag = true;
                            root.drag-source = idx;
                        }
                        if (root.drag-source != -1) {
                            // 행 높이가 일정하므로 이동한 픽셀을 행 수로 환산한다.
                            root.drag-target = idx + Math.round((self.mouse-y - self.pressed-y) / root.row-h);
                        }
                    }
                    clicked => {
                        if (!root.did-drag) {
                            root.commit-edit();
                            if (row.is-group) {
                                root.toggle-group(row.id);
                            } else {
                                root.open-memo(row.id);
                            }
                        }
                    }
                    double-clicked => {
                        // 그룹 이름은 더블클릭으로 바로 고친다.
                        if (row.is-group) {
                            root.editing-text = row.title;
                            root.editing-id = row.id;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 6px + row.depth * 14px; // 트리 들여쓰기
                    padding-right: 4px;
                    spacing: 6px;

                    // 그룹: 펼침 표시 / 메모: 색 악센트
                    if row.is-group: Text {
                        width: 14px;
                        text: row.child-count == 0 ? "" : (row.expanded ? "▾" : "▸");
                        font-size: 10px;
                        color: #b0a99a;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    if row.is-group: Text {
                        text: "📁";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    if !row.is-group: Rectangle {
                        width: 5px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2.5px;
                        background: Palette.swatch(row.color);
                    }

                    // 이름: 편집 중인 그룹만 LineEdit 로 바뀐다.
                    if root.editing-id == row.id: LineEdit {
                        horizontal-stretch: 1;
                        text: row.title;
                        init => { self.focus(); }
                        edited(t) => { root.editing-text = t; }
                        accepted => { root.commit-edit(); }
                    }
                    if root.editing-id != row.id: Text {
                        text: row.is-group
                            ? (row.title == "" ? Strings.ui_list_group_untitled : row.title)
                            : (row.title == "" ? Strings.ui_list_memo_untitled : row.title);
                        font-size: 14px;
                        font-weight: row.is-group ? 700 : 400;
                        color: row.title == "" ? #9a9384 : #ece7db;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if row.is-group: Text {
                        text: row.child-count > 0 ? row.child-count : "";
                        font-size: 11px;
                        color: #8d8778;
                        vertical-alignment: center;
                    }
                    del-ta := TouchArea {
                        width: 28px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "🗑";
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: del-ta.has-hover ? 1 : 0.4;
                        }
                        clicked => { root.commit-edit(); root.delete-row(row.id, row.is-group); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 스티커 창: 메모 하나 = 창 하나. 무프레임.
//  - 제목 바 드래그 → 이동 (Rust 가 처리; X11 에선 자석 스냅까지)
//  - 제목 바 더블클릭 → 얇은 바 접기/펴기
//  - 🎨 색 팔레트, ＋ 새 메모, ✕ 창 닫기(삭제 아님)
// ---------------------------------------------------------------------------
export component StickyWindow inherits Window {
    title: root.memo-title == "" ? Strings.ui_sticky_window_title : root.memo-title;
    no-frame: true;
    always-on-top: true;
    background: #0000;
    preferred-width: 260px;
    preferred-height: 240px;
    min-width: 160px;
    min-height: 28px;
    resize-border-width: 4px;

    in property <string> memo-title;
    in-out property <string> memo-text;
    in property <string> sticky-color: "yellow";
    // 창 불투명도(%). 슬라이더를 끄는 동안엔 UI 가 직접 갱신(미리보기)하므로 in-out.
    in-out property <float> sticky-opacity: 100;
    in property <bool> collapsed: false;
    callback edited(string);
    callback close-requested();
    callback new-memo();
    callback set-color(string);
    callback set-opacity(float);
    callback toggle-collapse();
    // 제목 바 끌기: OS 에 맡기지 않고 포인터를 직접 따라간다 — 그래야 손을 떼기 전,
    // 끄는 도중에 자석 스냅이 걸린다. 인자는 모두 창 좌상단 기준 논리 px.
    //   begin-drag: 잡은 지점. 창 좌표를 못 다루는 환경(네이티브 Wayland)이면
    //               Rust 가 OS 이동으로 폴백하고 false 를 돌려준다 → 이후 추적 중단.
    callback begin-drag(float, float) -> bool;
    callback drag-move(float, float);   // 현재 포인터 위치
    callback drag-end();

    private property <bool> show-palette: false;
    // 이번 누름이 끌기로 넘어갔는가 / 그 끌기를 우리가 직접 따라가는 중인가.
    private property <bool> drag-started: false;
    private property <bool> drag-manual: false;

    public function focus-body() { body.focus(); }

    Rectangle {
        background: Palette.bg(root.sticky-color);
        // 각진 창 — 둥근 모서리 없음.
        border-radius: 0px;
        border-width: 1px;
        border-color: Palette.bar(root.sticky-color).darker(0.15);
        clip: true;
        // 창 전체(배경+글자)를 함께 흐리게 한다 — 데스크탑이 비쳐 보이는 위젯 느낌.
        opacity: root.sticky-opacity / 100;

        VerticalLayout {
            // ---- 제목 바 (드래그 핸들 + 접기 토글) ----
            Rectangle {
                // 접었을 때 창 높이(main.rs 의 BAR_HEIGHT)와 반드시 같아야 한다.
                height: 28px;
                background: Palette.bar(root.sticky-color);

                bar-ta := TouchArea {
                    moved => {
                        // 4px 넘게 움직여야 끌기로 친다 (클릭·더블클릭 오인 방지).
                        if (!root.drag-started
                            && (self.mouse-x > self.pressed-x + 4px || self.mouse-x < self.pressed-x - 4px
                                || self.mouse-y > self.pressed-y + 4px || self.mouse-y < self.pressed-y - 4px)) {
                            root.drag-started = true;
                            root.drag-manual = root.begin-drag(self.pressed-x / 1px, self.pressed-y / 1px);
                        }
                        if (root.drag-manual) {
                            root.drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            if (root.drag-manual) { root.drag-end(); }
                            root.drag-started = false;
                            root.drag-manual = false;
                        }
                    }
                    double-clicked => { root.toggle-collapse(); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 2px;
                    Text {
                        text: root.memo-title == "" ? Strings.ui_sticky_default_title : root.memo-title;
                        font-size: 13px;
                        font-weight: 700;
                        color: Palette.ink(root.sticky-color);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    palette-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "🎨";
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: palette-ta.has-hover ? 1 : 0.6;
                        }
                        clicked => { root.show-palette = !root.show-palette; }
                    }
                    plus-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "＋";
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: plus-ta.has-hover ? 1 : 0.55;
                        }
                        clicked => { root.new-memo(); }
                    }
                    close-ta := TouchArea {
                        width: 26px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "✕";
                            font-size: 13px;
                            font-weight: 700;
                            color: Palette.ink(root.sticky-color);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: close-ta.has-hover ? 1 : 0.55;
                        }
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // ---- 색 · 투명도 패널 (🎨 로 토글) ----
            // 색과 투명도를 함께 만지는 경우가 많아, 고른 뒤에도 패널을 닫지 않는다.
            if root.show-palette: Rectangle {
                height: 72px;
                background: Palette.bar(root.sticky-color).darker(0.06);
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: Palette.swatch(key);
                            border-width: root.sticky-color == key ? 3px : 1px;
                            border-color: root.sticky-color == key ? #ffffff : #00000040;
                            chip := TouchArea {
                                clicked => { root.set-color(key); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: Strings.ui_sticky_opacity;
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 20; // 하한 — 코어의 MIN_OPACITY 와 맞춘다
                            maximum: 100;
                            value: root.sticky-opacity;
                            // 끄는 동안엔 미리보기만, 손을 뗄 때 한 번 저장한다.
                            changed(v) => { root.sticky-opacity = v; }
                            released(v) => { root.set-opacity(v); }
                        }
                        Text {
                            text: Math.round(root.sticky-opacity) + "%";
                            font-size: 11px;
                            color: Palette.ink(root.sticky-color);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 34px;
                        }
                    }
                }
            }

            // ---- 본문 (접힌 동안엔 창 높이가 제목 바와 같아 안 보인다) ----
            body := TextEdit {
                visible: !root.collapsed;
                min-height: 0;
                vertical-stretch: 1;
                font-size: 13px;
                wrap: word-wrap;
                text <=> root.memo-text;
                edited => { root.edited(self.text); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 환경설정 창. 여기의 값은 모두 **기기 로컬**이라 동기화하지 않는다
// (settings.rs 의 Settings 와 1:1 대응).
// 값은 "저장"을 눌러야 반영된다 — Rust 가 범위를 다듬어 되돌려 쓴다.
// ---------------------------------------------------------------------------
component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 2px;
    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: #ece7db;
    }
    if root.hint != "": Text {
        text: root.hint;
        font-size: 10px;
        color: #a8a294;
        wrap: word-wrap;
    }
    @children
}

export component SettingsWindow inherits Window {
    title: Strings.ui_settings_window_title;
    preferred-width: 400px;
    preferred-height: 600px;
    min-width: 340px;
    background: #2e2b27;

    // Rust 가 현재 설정을 넣어 두고, 저장할 때 그대로 읽어 간다.
    in-out property <string> lang-sel: "auto";
    in-out property <int> unlock-days: 30;
    in-out property <int> idle-minutes: 0;
    in-out property <string> default-color: "yellow";
    in-out property <int> default-opacity: 100;
    in-out property <int> merge-seconds: 15;
    // 저장 결과 등 한 줄 안내.
    in property <string> status;
    // 지금 잠금이 풀려 있는가. 잠겨 있으면 "지금 잠그기"를 눌러도 의미가 없다.
    in property <bool> unlocked: false;

    callback apply();
    callback lock-now();
    callback close-requested();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: Strings.ui_settings_title;
            font-size: 16px;
            font-weight: 700;
            color: #f0ead6;
        }

        // ---- 언어 ----
        SettingRow {
            label: Strings.ui_settings_lang;
            hint: Strings.ui_settings_lang_hint;
            HorizontalLayout {
                TabButton {
                    label: Strings.ui_settings_lang_auto;
                    active: root.lang-sel == "auto";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "auto"; }
                }
                // 언어 이름은 **번역하지 않는다** — 각 언어를 그 언어로 써야 지금 무슨
                // 언어인지 모르는 사용자도 자기 언어를 찾을 수 있다.
                TabButton {
                    label: "한국어";
                    active: root.lang-sel == "ko";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "ko"; }
                }
                TabButton {
                    label: "English";
                    active: root.lang-sel == "en";
                    ink: #d8d2c2;
                    clicked => { root.lang-sel = "en"; }
                }
            }
        }

        // ---- 잠금 ----
        SettingRow {
            label: Strings.ui_settings_unlock_days;
            hint: Strings.ui_settings_unlock_days_hint;
            SpinBox {
                minimum: 0;
                maximum: 365;
                value <=> root.unlock-days;
            }
        }

        SettingRow {
            label: Strings.ui_settings_idle_minutes;
            hint: Strings.ui_settings_idle_minutes_hint;
            SpinBox {
                minimum: 0;
                maximum: 1440;
                value <=> root.idle-minutes;
            }
        }

        // ---- 새 메모 기본값 ----
        SettingRow {
            label: Strings.ui_settings_default_color;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for key in ["yellow", "pink", "green", "blue", "purple"]: Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Palette.swatch(key);
                    border-width: root.default-color == key ? 3px : 1px;
                    border-color: root.default-color == key ? #ffffff : #00000040;
                    TouchArea {
                        clicked => { root.default-color = key; }
                    }
                }
            }
        }

        SettingRow {
            label: Strings.ui_settings_default_opacity;
            HorizontalLayout {
                spacing: 6px;
                Slider {
                    horizontal-stretch: 1;
                    minimum: 20; // 코어의 MIN_OPACITY 와 맞춘다
                    maximum: 100;
                    value: root.default-opacity;
                    changed(v) => { root.default-opacity = Math.round(v); }
                }
                Text {
                    text: root.default-opacity + "%";
                    font-size: 11px;
                    color: #ece7db;
                    vertical-alignment: center;
                    width: 40px;
                    horizontal-alignment: right;
                }
            }
        }

        // ---- 동기화 ----
        SettingRow {
            label: Strings.ui_settings_merge_seconds;
            hint: Strings.ui_settings_merge_seconds_hint;
            SpinBox {
                minimum: 3;
                maximum: 3600;
                value <=> root.merge-seconds;
            }
        }

        if root.status != "": Text {
            text: root.status;
            font-size: 11px;
            color: #a8d0a8;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: Strings.ui_settings_lock_now;
                enabled: root.unlocked;
                clicked => { root.lock-now(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: Strings.ui_settings_close;
                clicked => { root.close-requested(); }
            }
            Button {
                text: Strings.ui_settings_save;
                primary: true;
                clicked => { root.apply(); }
            }
        }
    }
}
