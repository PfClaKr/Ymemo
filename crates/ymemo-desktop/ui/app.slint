import { LineEdit, Button } from "std-widgets.slint";

// 스티커 메모 창.
//  - no-frame + always-on-top + 반투명 배경 (데스크탑 위젯 스타일)
//  - 시작 시 잠금 화면: 마스터 암호 입력 → Rust 쪽에서 vault 를 열면 메모 UI 로 전환.
//  - 🔗 버튼으로 페어링 패널(자기 QR + 상대 기기 ID 등록) 토글.
export component AppWindow inherits Window {
    title: "Ymemo";
    no-frame: true;
    always-on-top: true;
    background: #0000; // 창 자체는 투명, 실제 배경은 아래 Rectangle
    preferred-width: 300px;
    preferred-height: 380px;
    min-width: 220px;
    min-height: 160px;

    // Rust 쪽에서 채워 넣는 메모 제목 목록
    in property <[string]> memos;
    // vault 가 열리기 전엔 잠금 화면을 보여준다
    in property <bool> locked: true;
    // 암호 오류 등 잠금 화면에 띄울 메시지
    in property <string> lock-message;
    // syncthing 이 떠 있는가 (페어링 가능 여부)
    in property <bool> sync-available: false;
    // 이 기기의 페어링 코드 (YMEMO1:...)
    in property <string> my-pairing-code;
    // 페어링 코드의 QR 렌더링
    in property <image> qr-image;
    // peer 등록 결과 메시지
    in property <string> peer-message;
    // 새 메모 추가 요청 (제목 문자열)
    callback add-memo(string);
    // 마스터 암호로 vault 열기 요청
    callback unlock(string);
    // 상대 기기 페어링 코드 등록 요청
    callback add-peer(string);

    // 페어링 패널 표시 여부 (앱 내 토글)
    private property <bool> show-sync: false;

    Rectangle {
        background: #fff9b1f2; // 반투명 노란 스티커
        border-radius: 10px;
        border-width: 1px;
        border-color: #e6d24a;

        if root.locked: VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: "Ymemo 🔒";
                font-size: 16px;
                font-weight: 700;
                color: #5c5c25;
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: root.lock-message;
                font-size: 12px;
                color: #a03a3a;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 6px;
                pw := LineEdit {
                    placeholder-text: "마스터 암호...";
                    input-type: InputType.password;
                    accepted => { root.unlock(self.text); }
                }
                Button {
                    text: "열기";
                    clicked => { root.unlock(pw.text); }
                }
            }
        }

        if !root.locked: VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Ymemo 📝";
                    font-size: 16px;
                    font-weight: 700;
                    color: #5c5c25;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "🔗";
                    clicked => { root.show-sync = !root.show-sync; }
                }
            }

            // ---- 페어링 패널 ----
            if root.show-sync && root.sync-available: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "기기 페어링";
                    font-size: 13px;
                    font-weight: 700;
                    color: #5c5c25;
                }
                Image {
                    source: root.qr-image;
                    width: 150px;
                    height: 150px;
                    image-rendering: pixelated;
                }
                Text {
                    text: root.my-pairing-code;
                    font-size: 9px;
                    color: #666;
                    wrap: char-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    peer := LineEdit {
                        placeholder-text: "상대 페어링 코드...";
                        accepted => { root.add-peer(self.text); }
                    }
                    Button {
                        text: "등록";
                        clicked => { root.add-peer(peer.text); }
                    }
                }
                Text {
                    text: root.peer-message;
                    font-size: 11px;
                    color: #5c5c25;
                    wrap: word-wrap;
                }
            }
            if root.show-sync && !root.sync-available: Text {
                text: "syncthing 을 찾지 못해 동기화가 꺼져 있습니다.";
                font-size: 12px;
                color: #a03a3a;
                wrap: word-wrap;
            }

            // ---- 메모 목록 ----
            if !root.show-sync: VerticalLayout {
                spacing: 8px;
                for memo in root.memos: Text {
                    text: "• " + memo;
                    font-size: 14px;
                    color: #333333;
                    wrap: word-wrap;
                }
            }

            // 남는 공간을 채워 입력 줄을 아래로 밀어낸다
            Rectangle { vertical-stretch: 1; }

            // 입력 줄
            HorizontalLayout {
                spacing: 6px;
                input := LineEdit {
                    placeholder-text: "새 메모 입력...";
                    accepted => {
                        root.add-memo(self.text);
                        self.text = "";
                    }
                }
                Button {
                    text: "추가";
                    clicked => {
                        root.add-memo(input.text);
                        input.text = "";
                    }
                }
            }
        }
    }
}
