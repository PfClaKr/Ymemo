# Rust 빌드 산출물
/target

# 로컬 전용 cargo 설정 (fontconfig shim 의 PKG_CONFIG_PATH 등, 머신 종속)
.cargo/config.toml

# Slint/IME 검증 스파이크 (머신 종속 경로, 커밋하지 않음)
/experiments

# Flutter (apps/mobile). 빌드 산출물만 제외한다.
#
# frb 바인딩(`lib/src/rust/`, `crates/ymemo-ffi/src/frb_generated.rs`)은 **커밋한다**:
# codegen 은 그 파일들과 함께 `ymemo-ffi` 의 lib.rs·Cargo.toml 도 고치므로, 생성물을
# 빼 두면 Flutter 가 없는 곳(=CI 의 cargo test --workspace)에서 컴파일이 깨진다.
# 커밋해 두면 CI 가 바인딩까지 함께 검증해 준다.
#
# `android/` 도 커밋한다 — applicationId·minSdk·권한·(장차) cargokit gradle 훅이 사는 곳이라
# 매번 다시 만들면 그 설정이 날아간다. iOS 도 착수할 때 같은 이유로 커밋 대상이 된다.
apps/mobile/ios/
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins*
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/jniLibs/
apps/mobile/android/**/build/
apps/mobile/**/*.iml

# 패키징 빌드 산출물 (에셋 packaging/assets/* 는 커밋, 아래 결과물은 제외)
/dist/
/packaging/windows/Output/
/packaging/windows/Ymemo.exe
/packaging/windows/ymemo-sync.exe
# CI 에서 내려받는 syncthing 아카이브/전개물
/st/
/st.zip
/st.tar.gz
/syncthing-*/

# OS / 에디터 잡동사니
.DS_Store
*.swp
