# Rust build output
/target

# Machine-local cargo config (PKG_CONFIG_PATH for the fontconfig shim, ...)
.cargo/config.toml

# Slint/IME spikes: machine-specific paths, never committed
/experiments

# Flutter (apps/mobile): only build output is ignored.
#
# The frb bindings (`lib/src/rust/`, `crates/ymemo-ffi/src/frb_generated.rs`) ARE committed:
# codegen also edits ymemo-ffi's lib.rs and Cargo.toml, so leaving them out breaks the build
# wherever Flutter is absent (CI's `cargo test --workspace`). Committed, CI checks them too.
#
# `android/` is committed as well — applicationId, minSdk, permissions and the future
# cargokit gradle hooks live there and would be lost on every regeneration. iOS will follow.
apps/mobile/ios/
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins*
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/jniLibs/
apps/mobile/android/**/build/
apps/mobile/android/.kotlin/
apps/mobile/**/*.iml

# Packaging output (packaging/assets/* is committed; the artifacts below are not)
/dist/
/packaging/windows/Output/
/packaging/windows/Ymemo.exe
/packaging/windows/ymemo-sync.exe
# syncthing archives CI downloads and unpacks
/st/
/st.zip
/st.tar.gz
/syncthing-*/

# OS and editor clutter
.DS_Store
*.swp
