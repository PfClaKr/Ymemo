<?xml version="1.0" encoding="utf-8"?>
<!-- Not a widget: the ordinary activity that asks what one list widget should show and what
     it should look like. Built by hand rather than in Flutter, because it is opened from the
     launcher, sometimes before the app has ever been unlocked, and starting an engine to draw
     three questions would make placing a widget take a second and a half. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/widget_list_configure_title"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- What the choices below add up to, updated as they are made. Not a rendering
                 of the real widget (that is RemoteViews, drawn by the launcher) but the same
                 card, heading and rows in the same colours, on something with a pattern so
                 the opacity is visible at all. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_preview_backdrop"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="9dp"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/preview_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/preview_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/preview_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="14dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="12dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/configure_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/widget_list_configure_locked"
                android:visibility="gone" />

            <!-- What to show -->
            <TextView
                android:id="@+id/configure_source_label"
                style="@style/WidgetConfigureSection"
                android:text="@string/widget_list_configure_source" />

            <RadioGroup
                android:id="@+id/configure_folders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- The memos a "pick them myself" widget shows. Hidden until that is the
                 answer, so the ordinary case is three short questions and not a wall of
                 checkboxes. -->
            <LinearLayout
                android:id="@+id/configure_picks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:visibility="gone" />

            <!-- Background -->
            <TextView
                style="@style/WidgetConfigureSection"
                android:text="@string/widget_list_configure_background" />

            <RadioGroup
                android:id="@+id/configure_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Opacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetConfigureSection"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/widget_list_configure_opacity" />

                <TextView
                    android:id="@+id/configure_opacity_value"
                    style="@style/WidgetConfigureSection"
                    android:layout_width="wrap_content"
                    android:gravity="end" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/configure_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <!-- Always a button, never "picked one, done": three answers cannot be given by tapping
         one of them, and backing out of the very first setup would leave no widget behind. -->
    <Button
        android:id="@+id/configure_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/widget_list_configure_done" />
</LinearLayout>
