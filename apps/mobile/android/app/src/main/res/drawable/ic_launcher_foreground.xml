<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's foreground layer: the same sticky note the desktop draws in
     `crates/ymemo-desktop/src/icon.rs` and `packaging/gen_icons.py` renders, so one picture
     stands for the app everywhere. Flat, with no outline: the icon has to hold together at
     16px in a tray, and a stroke at that size is what turned the old one into a smudge.

     Adaptive icons are 108x108 with only the middle 72x72 guaranteed to survive the
     launcher's mask, so the paper stays inside 32..76 both ways. The pre-API-26 PNGs in
     mipmap-*/ are the same geometry, rendered by packaging/gen_icons.py. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The paper: a square with its top-right corner taken off by the fold. -->
    <path
        android:pathData="M40,32 L63,32 L76,45 L76,68 A8,8 0 0 1 68,76 L40,76 A8,8 0 0 1 32,68 L32,40 A8,8 0 0 1 40,32 Z"
        android:fillColor="#FFFDF5" />

    <!-- The lifted corner, a step darker than the badge: the back of the sheet. -->
    <path
        android:pathData="M63,32 L76,45 L63,45 Z"
        android:fillColor="#BA9E1E" />

    <!-- Three lines of writing. The first stops short of the fold and the last is the end of
         a sentence; three equal bars would read as a list. -->
    <path
        android:pathData="M40.75,52.75 L61.25,52.75 M40.75,61.25 L67.25,61.25 M40.75,69.75 L52.25,69.75"
        android:strokeColor="#5C5010"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
