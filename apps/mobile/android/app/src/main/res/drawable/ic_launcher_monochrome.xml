    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.0703125"
        android:scaleY="0.0703125">

        <group android:rotation="10" android:pivotX="550" android:pivotY="470">
            <path
                android:pathData="M370,170 L730,170 A120,120 0 0 1 850,290 L850,650 A120,120 0 0 1 730,770 L370,770 A120,120 0 0 1 250,650 L250,290 A120,120 0 0 1 370,170 Z"
                android:fillColor="#000000"
                android:fillAlpha="0.55" />
        </group>

        <path
            android:fillType="evenOdd"
            android:pathData="M290,290 L650,290 A120,120 0 0 1 770,410 L770,700 L580,890 L290,890 A120,120 0 0 1 170,770 L170,410 A120,120 0 0 1 290,290 Z M290,448 L640,448 A32,32 0 0 1 640,512 L290,512 A32,32 0 0 1 290,448 Z M290,568 L580,568 A32,32 0 0 1 580,632 L290,632 A32,32 0 0 1 290,568 Z"
            android:fillColor="#000000" />
    </group>
</vector>
