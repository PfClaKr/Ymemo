<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13's themed icon: the launcher tints this one colour, so only the silhouette
     speaks. The same two notes as ic_launcher_foreground.xml; the writing and the peel are
     cut out of the front note (even-odd), and the front note is cut out of the one behind by
     drawing it over a gap, so the two sheets still read as two. -->
