<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the app while it starts (Android 7-11; 12+ draws its own splash from
     values-v31). The app's own paper colour with its mark in the middle, so starting goes
     from the mark straight into the list — the template's white flashed before the cream. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/app_background" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
