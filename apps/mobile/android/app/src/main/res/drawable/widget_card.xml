<?xml version="1.0" encoding="utf-8"?>
<!-- The rounded card every widget sits on. Drawn white on purpose: it is used as an
     ImageView `src` and recolored at runtime with setColorFilter, which is the only way
     RemoteViews can give a shape a color it did not know at build time. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="20dp" />
</shape>
