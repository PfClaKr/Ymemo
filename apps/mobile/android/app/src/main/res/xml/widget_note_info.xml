<?xml version="1.0" encoding="utf-8"?>
<!-- configure: which memo to pin is asked before the widget appears, so it never sits
     there empty waiting to be set up. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.ymemo.ymemo_mobile.widget.NoteConfigureActivity"
    android:description="@string/widget_note_description"
    android:initialLayout="@layout/widget_note"
    android:minHeight="80dp"
    android:minResizeHeight="60dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview_note"
    android:previewLayout="@layout/widget_note"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
