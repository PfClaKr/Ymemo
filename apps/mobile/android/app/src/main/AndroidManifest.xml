<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For scanning pairing QRs. Memos stay in the app-private directory. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Installable on devices without a camera; only QR scanning is unavailable. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The bundled sync daemon talks to the user's other devices directly. Both are normal
         permissions: granted at install, never prompted for. Nothing is sent to a server of
         ours — there isn't one — and what does travel is already E2E encrypted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the daemon notice it is on wifi again instead of retrying blindly. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- LAN pairing listens for a broadcast, and the wifi stack drops packets not addressed
         to this device unless a multicast lock is held (see MainActivity). Also a normal
         permission; the lock itself is only taken while the pairing screen is open. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The fingerprint prompt for the optional biometric unlock. It is only ever shown
         because the user turned that setting on, and it unlocks nothing by itself: what it
         releases is the key the platform keystore is already holding. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- allowBackup is on by default, which would let Android copy the app's private
         directory into the user's cloud backup — and that directory holds the **plaintext**
         SQLite cache of every memo, alongside the encrypted vault. A local-first app that
         quietly ships its notes to a backup server is not local-first, so it is off. It also
         keeps a restored backup from resurrecting a stale cache on another device, which
         syncing would then have to argue with. -->
    <application
        android:label="Ymemo"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Long-pressing the launcher icon. A shortcut intent cannot carry extras, so
                 these two arrive as actions of their own; MainActivity maps them onto the
                 same actions the widgets send in their extras. -->
            <intent-filter>
                <action android:name="dev.ymemo.action.NEW_MEMO"/>
                <action android:name="dev.ymemo.action.NEW_PHOTO_MEMO"/>
                <action android:name="dev.ymemo.action.WIDGET"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widgets.
             All three are drawn by the launcher, in its process, while this app may not be
             running at all: they read the snapshot MainActivity stores for them and never
             touch the vault or its cache. See widget/Snapshot.kt for why that is a copy.

             exported="true" is required of a widget provider — the launcher is what sends it
             APPWIDGET_UPDATE — and is not a way into anything: the receivers read a private
             SharedPreferences file and answer nothing. -->
        <receiver
            android:name=".widget.QuickWriteWidget"
            android:exported="true"
            android:label="@string/widget_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_write_info" />
        </receiver>

        <receiver
            android:name=".widget.NoteWidget"
            android:exported="true"
            android:label="@string/widget_note_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_note_info" />
        </receiver>

        <receiver
            android:name=".widget.MemoListWidget"
            android:exported="true"
            android:label="@string/widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_list_info" />
        </receiver>

        <!-- Redraws the widgets when the app is replaced or the system language changes;
             both leave what is on the home screen wrong, and neither runs the app. -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- The list widget's rows. BIND_REMOTEVIEWS keeps the permission to bind with the
             system, so only the launcher can ask this for views. -->
        <service
            android:name=".widget.MemoListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- "Which memo?", both when a sticky widget is added and when its ... is tapped.
             Exported because the launcher starts it as part of placing the widget. -->
        <activity
            android:name=".widget.NoteConfigureActivity"
            android:exported="true"
            android:label="@string/widget_note_label"
            android:theme="@style/WidgetConfigureTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <!-- The same for the list widget: which folder, what color, how solid. Exported for
             the same reason, and answering the same nothing — it reads the private
             SharedPreferences file the widgets read and writes back to it. -->
        <activity
            android:name=".widget.ListConfigureActivity"
            android:exported="true"
            android:label="@string/widget_list_label"
            android:theme="@style/WidgetConfigureTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
